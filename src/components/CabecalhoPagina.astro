---
import FundoIlustrado from '@/components/FundoIlustrado.astro'
import type { Cena } from '@/lib/cenas'

/**
 * Faixa de topo das paginas internas.
 *
 * Houve aqui, por uma versao, a opcao de pintar o fundo com o vinho da marca
 * em vez de usar imagem. Foi tirada: as oito paginas ficam com o mesmo
 * tratamento, foto sob o mesmo veu escuro. Duas cores de veu em paginas
 * vizinhas nao leem como sistema, leem como descuido.
 */
interface Props {
  titulo: string
  subtitulo?: string
  trilha: readonly { nome: string; href: string }[]
  /** Cena de fundo. Sem ela o cabecalho fica so com o grafite chapado. */
  cena?: Cena
  /** Foto de fundo. Entra no lugar da cena desenhada. */
  foto?: ImageMetadata
  /** Texto alternativo da foto. */
  descricaoDaFoto?: string
  /** Enquadramento do corte da foto. */
  enquadramento?: string
}
const { titulo, subtitulo, trilha, cena, foto, descricaoDaFoto, enquadramento } = Astro.props
const atual = trilha[trilha.length - 1]
---

<section
  class="relative overflow-hidden bg-gradient-to-b from-graphite-900 to-graphite-800 py-12 text-white"
>
  {cena && <FundoIlustrado
      cena={cena}
      foto={foto}
      descricaoDaFoto={descricaoDaFoto}
      enquadramento={enquadramento}
    />}

  <div class="relative mx-auto w-full max-w-[820px] px-5">
    <nav class="mb-4 text-rotulo text-sobre-escuro-fraco" aria-label="Você está em">
      {
        trilha.slice(0, -1).map((item) => (
          <>
            <a class="inline-flex min-h-[36px] items-center text-sobre-escuro no-underline hover:underline" href={item.href}>
              {item.nome}
            </a>
            <span aria-hidden="true"> › </span>
          </>
        ))
      }
      <span>{atual?.nome}</span>
    </nav>

    <h1 class="text-pagina text-white">{titulo}</h1>
    {subtitulo && <p class="mt-2 text-cartao text-sobre-escuro">{subtitulo}</p>}
    <slot />
  </div>
</section>
