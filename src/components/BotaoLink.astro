---
import { cn } from '@/lib/utils'

/**
 * Link com aparencia de botao, para destinos internos.
 *
 * As variantes espelham as de BotaoWhatsapp de proposito: os dois aparecem
 * lado a lado o tempo todo e precisam ter a mesma altura, o mesmo raio e o
 * mesmo peso. Antes deste componente, a versao `sobreEscuro` estava copiada
 * em sete paginas — mudar uma deixaria as outras seis para tras.
 */
interface Props {
  href: string
  variante?: 'primario' | 'claro' | 'sobreEscuro' | 'contorno' | 'escuro'
  larguraTotal?: boolean
  pequeno?: boolean
  class?: string
}

const {
  href,
  variante = 'contorno',
  larguraTotal = false,
  pequeno = false,
  class: classe,
} = Astro.props

const variantes = {
  /* Solida, para o CTA principal. E a unica legivel sobre foto: botao
     fantasma sobre fundo fotografico e o caso que a norma manda evitar. */
  primario: 'border-transparent bg-wine text-white hover:bg-wine-dark',
  /* Sobre o vinho. `primario` ali seria vinho sobre vinho: o texto continua
     legivel, entao nenhum teste de contraste reclama, mas o botao perde a
     forma e vira uma palavra solta. Invertido, ele e a coisa mais clara da
     barra, que e o que um CTA tem de ser. */
  claro: 'border-transparent bg-white text-wine hover:bg-wine-soft',
  sobreEscuro: 'border-white/30 bg-white/10 text-white hover:bg-white/20',
  contorno: 'border-line-forte text-graphite-900 hover:border-graphite-900 hover:bg-line-soft',
  escuro: 'border-transparent bg-graphite-900 text-white hover:bg-graphite-700',
} as const

/*
 * `active:translate-y-px` e a unica coisa que este botao faz ao ser
 * apertado. Ate agora ele so trocava de cor no hover, e no celular nao ha
 * hover: o dedo tocava e a tela nao respondia nada ate a pagina abrir.
 *
 * Um pixel para baixo e pouco de proposito. O que se quer e a sensacao de
 * que a tecla afundou, e nao uma animacao. Quem pediu movimento reduzido
 * recebe o mesmo deslocamento sem transicao, porque o bloco de
 * prefers-reduced-motion em global.css limita a transicao ao que nao se
 * desloca. Apertar um botao nao e o movimento que causa enjoo.
 */
const classes = cn(
  'inline-flex items-center justify-center gap-2 rounded-md border font-bold no-underline active:translate-y-px transition-[color,background-color,border-color,translate]',
  pequeno ? 'min-h-[42px] px-4 py-2.5 text-corpo' : 'min-h-[50px] px-6 py-3.5 text-base',
  larguraTotal && 'w-full',
  variantes[variante],
  classe
)
---

<a class={classes} href={href}><slot /></a>
