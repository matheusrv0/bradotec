---
/**
 * Bloco de limite de escopo. Existe para o site nao prometer prazo,
 * aprovacao ou resultado que dependa de orgao publico ou de profissional
 * habilitado — regra fixa do projeto, valida para copy, FAQ e CTA.
 */
interface Props {
  titulo: string
}
const { titulo } = Astro.props
---

<section class="py-5 py-lg-9">
  <div class="container">
    <div
      class="card border bg-light-gray"
      data-aos="fade-up"
      data-aos-delay="100"
      data-aos-duration="1000"
    >
      <div class="card-body d-flex flex-column flex-md-row gap-4 gap-md-6 align-items-start">
        <iconify-icon
          icon="solar:shield-warning-line-duotone"
          class="fs-10 text-primary flex-shrink-0"
        />
        <div>
          <h2 class="mb-3 fs-7">{titulo}</h2>
          <p class="mb-0 fs-4 aviso-texto">
            <slot />
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .aviso-texto {
    max-width: 76ch;
  }
</style>
