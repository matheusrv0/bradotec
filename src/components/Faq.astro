---
import { getCollection } from 'astro:content'
import type { PaginaComFaq } from '@/content.config'

/**
 * Renderiza as perguntas marcadas para esta pagina.
 *
 * Usa <details> nativo do navegador: o acordeao abre e fecha mesmo com o
 * JavaScript desligado, e ja vem acessivel por teclado de fabrica. Um
 * componente React aqui custaria download de biblioteca para reproduzir
 * algo que o HTML faz sozinho.
 *
 * O JSON-LD correspondente sai do mesmo dado, via faqDaPagina() — ver
 * `getEntriesFaq` abaixo.
 */
interface Props {
  pagina: PaginaComFaq
  titulo?: string
  descricao?: string
}

const { pagina, titulo = 'Perguntas frequentes', descricao } = Astro.props

const perguntas = (await getCollection('faq', ({ data }) => data.paginas.includes(pagina)))
  .map((entrada) => entrada.data)
  .sort((x, y) => x.ordem - y.ordem)
---

{
  perguntas.length > 0 && (
    <section class="bg-canvas py-16 lg:py-20" id="faq">
      <div class="mx-auto w-full max-w-wrap px-5">
        <div class="mb-9 max-w-[760px]">
          <span class="mb-3 inline-flex items-center gap-2 text-apoio font-bold text-wine">
            <span class="h-0.5 w-[22px] rounded-sm bg-wine" aria-hidden="true" />
            Dúvidas
          </span>
          <h2 class="text-secao">{titulo}</h2>
          {descricao && <p class="mt-2 text-ink-soft">{descricao}</p>}
        </div>

        <div class="max-w-[860px]">
          {perguntas.map((item) => (
            <details class="group border-b border-line py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-0.5 py-4 text-cartao font-bold text-graphite-900 [&::-webkit-details-marker]:hidden">
                {item.pergunta}
                <span
                  class="size-3 shrink-0 rotate-45 border-b-2 border-r-2 border-ash-500 transition-transform duration-200 ease-saida group-open:-rotate-135"
                  aria-hidden="true"
                />
              </summary>
              <p class="m-0 px-0.5 pb-5 text-corpo text-ink-soft">{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
