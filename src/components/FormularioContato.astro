---
import { ehPlaceholder, site } from '@/config/site'

/**
 * Formulario de contato.
 *
 * Foi uma ilha React na primeira versao. Dois problemas apareceram na
 * medicao e nos testes:
 *
 * 1. Custava 83 KB de JavaScript comprimido ao visitante — quase tudo
 *    React — na pagina onde o lead converte.
 * 2. Pior: antes de hidratar, clicar em "Enviar" disparava o envio nativo
 *    do formulario e a validacao em React nunca rodava. Os testes de
 *    navegador no celular pegaram exatamente isso.
 *
 * Agora a validacao e a nativa do HTML, com as mensagens em portugues
 * aplicadas por setCustomValidity. Funciona desde o primeiro pixel: o
 * navegador bloqueia o envio invalido mesmo que o script ainda nao tenha
 * carregado. O script so melhora a apresentacao do erro.
 *
 * O envio monta a mensagem e abre o WhatsApp. Nenhum dado e armazenado.
 * Quando o back-end de specs/backend/ existir, e trocar o `submit`.
 */

const PERFIS = [
  'Empresa ou comércio',
  'Condomínio ou administradora',
  'Igreja, escola ou instituição',
  'Proprietário de imóvel',
  'Proprietário de veículo ou frota',
] as const

const ASSUNTOS = [
  'Segurança contra incêndio e pânico',
  'Licenças, alvarás e certidões',
  'Regularização de imóvel ou edificação',
  'Exigência ou notificação recebida',
  'Gestão documental recorrente',
  'Documentação veicular ou frota',
  'Diagnóstico de Regularização',
  'Ainda não sei',
] as const

const URGENCIAS = [
  'Imediata, há prazo correndo',
  'Nas próximas semanas',
  'Estou planejando',
] as const

/** Resolvido no servidor: importar site.ts no script levaria o Zod ao cliente. */
const numeroWhatsapp = ehPlaceholder(site.whatsapp) ? '' : site.whatsapp.replace(/\D/g, '')

const rotulo = 'block text-apoio font-bold text-ink'
const campo =
  'mt-1.5 w-full rounded-md border border-line-forte bg-white px-3.5 py-3 text-ink outline-none transition-colors focus-visible:border-graphite-900 focus-visible:ring-2 focus-visible:ring-graphite-900/25 aria-[invalid=true]:border-wine'
---

<form class="flex flex-col gap-5" data-formulario data-whatsapp={numeroWhatsapp} novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={rotulo} for="nome">Nome <span class="text-wine">*</span></label>
      <input
        id="nome"
        name="nome"
        class={campo}
        required
        minlength="2"
        autocomplete="name"
        data-erro="Informe o seu nome."
      />
    </div>

    {/*
      Os parenteses do `pattern` PRECISAM de escape. O navegador compila o
      pattern com a flag `v`, onde ( ) [ ] { } / - \ | sao reservados dentro
      da classe de caracteres. Sem escape a expressao nem compila, e um
      pattern que nao compila e descartado em silencio: o campo volta a
      aceitar qualquer coisa. Foi assim que "nao tenho" passou como telefone
      valido ate um teste de navegador pegar.
    */}
    <div>
      <label class={rotulo} for="telefone">
        WhatsApp ou telefone <span class="text-wine">*</span>
      </label>
      <input
        id="telefone"
        name="telefone"
        type="tel"
        inputmode="tel"
        class={campo}
        required
        minlength="8"
        pattern="[\d\s\(\)+\-]+"
        autocomplete="tel"
        data-erro="Informe um telefone para contato."
        data-erro-formato="Use apenas números, espaços, parênteses, + ou -."
      />
    </div>

    <div>
      <label class={rotulo} for="cidade">
        Cidade <span class="font-normal text-ash-500">(opcional)</span>
      </label>
      <input id="cidade" name="cidade" class={campo} autocomplete="address-level2" />
    </div>

    <div>
      <label class={rotulo} for="organizacao">
        Empresa ou condomínio <span class="font-normal text-ash-500">(opcional)</span>
      </label>
      <input id="organizacao" name="organizacao" class={campo} autocomplete="organization" />
    </div>

    <div>
      <label class={rotulo} for="perfil">Você é <span class="text-wine">*</span></label>
      <select id="perfil" name="perfil" class={campo} required data-erro="Selecione uma opção.">
        <option value="" selected disabled>Selecione</option>
        {PERFIS.map((item) => <option value={item}>{item}</option>)}
      </select>
    </div>

    <div>
      <label class={rotulo} for="urgencia">Urgência <span class="text-wine">*</span></label>
      <select
        id="urgencia"
        name="urgencia"
        class={campo}
        required
        data-erro="Selecione a urgência."
      >
        <option value="" selected disabled>Selecione</option>
        {URGENCIAS.map((item) => <option value={item}>{item}</option>)}
      </select>
    </div>
  </div>

  <div>
    <label class={rotulo} for="assunto">Assunto <span class="text-wine">*</span></label>
    <select id="assunto" name="assunto" class={campo} required data-erro="Selecione um assunto.">
      <option value="" selected disabled>Selecione</option>
      {ASSUNTOS.map((item) => <option value={item}>{item}</option>)}
    </select>
  </div>

  <div>
    <label class={rotulo} for="descricao">
      Descreva a situação <span class="font-normal text-ash-500">(opcional)</span>
    </label>
    <textarea
      id="descricao"
      name="descricao"
      rows="5"
      maxlength="1200"
      class={campo}
      data-erro="Máximo de 1200 caracteres."></textarea>
    <p class="mt-1.5 text-apoio text-ash-500">
      Quanto mais específico for o que você contar, mais direto será o retorno.
    </p>
  </div>

  <div>
    <button
      type="submit"
      class="inline-flex min-h-[50px] w-full items-center justify-center rounded-md bg-wine px-6 py-3.5 font-bold text-white active:translate-y-px transition-[color,background-color,border-color,translate] hover:bg-wine-dark disabled:opacity-60 sm:w-auto"
    >
      {numeroWhatsapp ? 'Enviar pelo WhatsApp' : 'Montar mensagem'}
    </button>
    <p class="mt-3 text-apoio text-ash-500">
      O envio abre o WhatsApp com os dados preenchidos. Nenhum dado é armazenado neste site.
    </p>
  </div>

  <div class="rounded-xl border border-warn-claro bg-warn-fundo p-5" role="status" data-pronta hidden>
    <p class="font-bold text-ink">Mensagem montada</p>
    <p class="mt-1.5 text-apoio text-ink-soft">
      O número de WhatsApp ainda não foi configurado neste site. Copie o texto abaixo e envie pelo
      canal que preferir.
    </p>
    <textarea
      readonly
      rows="10"
      aria-label="Mensagem pronta para copiar"
      class="mt-3 w-full rounded-md border border-warn-claro bg-white px-3.5 py-3 text-apoio text-ink"
      data-texto-pronto></textarea>
  </div>
</form>

<script>
  const formulario = document.querySelector<HTMLFormElement>('[data-formulario]')

  if (formulario) {
    type Campo = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement

    const campos = [...formulario.querySelectorAll<Campo>('[data-erro]')]
    const pronta = formulario.querySelector<HTMLElement>('[data-pronta]')
    const textoPronto = formulario.querySelector<HTMLTextAreaElement>('[data-texto-pronto]')
    const numero = formulario.dataset.whatsapp ?? ''

    /** Mensagem certa para o tipo de invalidez do campo. */
    const mensagemDe = (campo: Campo): string => {
      const formato = campo.dataset.erroFormato
      if (formato && !campo.validity.valueMissing && !campo.validity.tooShort) return formato
      return campo.dataset.erro ?? 'Confira este campo.'
    }

    const limparErro = (campo: Campo) => {
      campo.removeAttribute('aria-invalid')
      campo.removeAttribute('aria-describedby')
      document.getElementById(`erro-${campo.name}`)?.remove()
    }

    const mostrarErro = (campo: Campo) => {
      limparErro(campo)

      const aviso = document.createElement('p')
      aviso.id = `erro-${campo.name}`
      aviso.setAttribute('role', 'alert')
      aviso.className = 'mt-1.5 text-apoio font-bold text-wine'
      aviso.textContent = mensagemDe(campo)

      campo.setAttribute('aria-invalid', 'true')
      campo.setAttribute('aria-describedby', aviso.id)
      campo.insertAdjacentElement('afterend', aviso)
    }

    const conferir = (campo: Campo) => {
      if (campo.checkValidity()) {
        limparErro(campo)
        return true
      }
      mostrarErro(campo)
      return false
    }

    for (const campo of campos) {
      campo.addEventListener('blur', () => conferir(campo))
      campo.addEventListener('input', () => {
        if (campo.getAttribute('aria-invalid') === 'true') conferir(campo)
      })
      campo.addEventListener('change', () => {
        if (campo.getAttribute('aria-invalid') === 'true') conferir(campo)
      })
    }

    const valor = (nome: string) =>
      (formulario.elements.namedItem(nome) as Campo | null)?.value.trim() ?? ''

    const montarMensagem = () => {
      const opcionais = [
        valor('cidade') ? `Cidade: ${valor('cidade')}` : null,
        valor('organizacao') ? `Empresa/condomínio: ${valor('organizacao')}` : null,
      ].filter((linha): linha is string => linha !== null)

      const descricao = valor('descricao')

      return [
        'Olá! Vim pelo site da Bradotec.',
        '',
        `Nome: ${valor('nome')}`,
        `Contato: ${valor('telefone')}`,
        ...opcionais,
        `Perfil: ${valor('perfil')}`,
        `Assunto: ${valor('assunto')}`,
        `Urgência: ${valor('urgencia')}`,
        ...(descricao ? ['', 'Situação:', descricao] : []),
      ].join('\n')
    }

    formulario.addEventListener('submit', (evento) => {
      evento.preventDefault()

      // Confere todos, para a pessoa ver de uma vez tudo que falta.
      const invalidos = campos.filter((campo) => !conferir(campo))
      if (invalidos.length > 0) {
        invalidos[0]?.focus()
        return
      }

      const texto = montarMensagem()

      if (!numero) {
        // Numero ainda e placeholder: entrega o texto para copiar em vez de
        // abrir um link quebrado.
        if (textoPronto) textoPronto.value = texto
        if (pronta) pronta.hidden = false
        return
      }

      window.open(
        `https://wa.me/${numero}?text=${encodeURIComponent(texto)}`,
        '_blank',
        'noopener'
      )
    })
  }
</script>
