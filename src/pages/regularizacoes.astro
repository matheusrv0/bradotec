---
import fotoCarimbo from '@/assets/fotos-licenciadas/documentos-em-mesa.jpg'
import AcordeaoFaq from '@/components/studiova/AcordeaoFaq.astro'
import AvisoEscopo from '@/components/studiova/AvisoEscopo.astro'
import Botao from '@/components/studiova/Botao.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import SecaoServicos from '@/components/studiova/SecaoServicos.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Regularizações', href: '/regularizacoes' },
] as const

const schemaFaq = await schemaFaqDaPagina('regularizacoes')

const situacoes = [
  'Empresa que precisa abrir, mudar de endereço ou ampliar a atividade',
  'Comércio que não consegue renovar o alvará por pendência documental',
  'Imóvel ou edificação com documentação incompleta ou desatualizada',
  'Exigência recebida e não atendida dentro do prazo',
  'Documentação espalhada entre contador, síndico e antigos responsáveis',
  'Licenças vencendo sem ninguém acompanhando os prazos',
] as const
---

<LayoutStudiova
  titulo="Regularização de empresas e imóveis em João Pessoa (PB) | Bradotec"
  descricao="Licenças, alvarás, certidões, protocolos e regularização de empresas e imóveis em João Pessoa/PB, com resposta a exigências e controle de vencimentos conduzidos até a conclusão."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoCarimbo}
    descricaoDaFoto="Documentos passando de mão em mão sobre uma mesa de escritório"
    titulo="Regularizações, licenças e gestão documental"
    subtitulo="Licenças, certidões, protocolos e regularização de empresas e imóveis em João Pessoa, com o processo acompanhado até a conclusão."
    trilha={trilha}
  >
    <Botao href="/contato">Solicitar orçamento</Botao>
  </CabecalhoPagina>

  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <TituloSecao
        numero="01"
        etiqueta="Bradotec Documentos"
        titulo="O que resolvemos"
        descricao="A maior parte dos problemas documentais não é falta de vontade: é falta de alguém para conduzir. É exatamente essa parte que a Bradotec assume."
      />
    </div>
  </section>

  <SecaoServicos
    divisao="documentos"
    numero="02"
    etiqueta="Serviços"
    titulo="Frentes que a divisão Documentos conduz"
  />

  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao numero="03" etiqueta="Casos" titulo="Situações mais comuns" escuro />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <ul class="list-unstyled mb-0">
              {
                situacoes.map((situacao, i) => (
                  <li
                    class="py-5 border-top border-white border-opacity-10 hstack gap-5 align-items-start"
                    data-aos="fade-up"
                    data-aos-delay={`${(i + 1) * 100}`}
                    data-aos-duration="1000"
                  >
                    <span class="round-36 flex-shrink-0 rounded-circle bg-primary hstack justify-content-center fw-medium fs-3">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="fs-5 text-white text-opacity-75">{situacao}</span>
                  </li>
                ))
              }
            </ul>

            <div class="hstack gap-3 flex-wrap mt-7">
              <Botao origem="licenca">Solicitar orçamento</Botao>
              <Botao href="/diagnostico" tom="contorno">Responder as 4 perguntas</Botao>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AvisoEscopo titulo="Sobre prazos">
    O tempo de cada processo depende da documentação existente, das exigências emitidas e da
    análise do órgão público responsável. Informamos o que está sob nosso controle e comunicamos o
    andamento a cada etapa, sem prometer prazo que não depende de nós.
  </AvisoEscopo>

  <AcordeaoFaq pagina="regularizacoes" numero="04" />
</LayoutStudiova>
