---
import fotoFrota from '@/assets/fotos-geradas/frota-em-garagem.jpg'
import AcordeaoFaq from '@/components/studiova/AcordeaoFaq.astro'
import BotaoSeta from '@/components/studiova/BotaoSeta.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import Icone from '@/components/studiova/Icone.astro'
import SecaoServicos from '@/components/studiova/SecaoServicos.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Documentação veicular', href: '/documentacao-veicular' },
] as const

const schemaFaq = await schemaFaqDaPagina('documentacao-veicular')

/** Venda cruzada: quem chega pela frota costuma ter licenca e incendio pendentes. */
const outrasFrentes = [
  { titulo: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
  { titulo: 'Licenças e regularização', href: '/regularizacoes' },
] as const
---

<LayoutStudiova
  titulo="Documentação veicular e gestão de frotas em João Pessoa (PB) | Bradotec Auto"
  descricao="Transferência, emplacamento, primeiro registro, segunda via, alteração de dados e regularização de pendências em João Pessoa/PB, além da gestão da documentação de frotas para empresas."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoFrota}
    descricaoDaFoto="Fileira de vans e utilitários estacionados lado a lado dentro de uma garagem, à noite"
    enquadramento="50% 52%"
    titulo="Documentação veicular e frotas"
    subtitulo="Transferência, emplacamento, segunda via e regularização de pendências em João Pessoa. Para empresas, a documentação da frota inteira sob controle."
    trilha={trilha}
  >
    <BotaoSeta href="/contato">Resolver documentação do meu veículo</BotaoSeta>
  </CabecalhoPagina>

  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <TituloSecao
        numero="01"
        etiqueta="Bradotec Auto"
        titulo="Processos do veículo, conduzidos"
        descricao="Cada processo tem etapas próprias e pendências que só aparecem no meio do caminho. A Bradotec conduz do início ao fim e informa o andamento a cada etapa."
      />
    </div>
  </section>

  <SecaoServicos divisao="auto" numero="02" etiqueta="Serviços" titulo="Serviços da divisão Auto" />

  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="03"
          etiqueta="Para empresas"
          titulo="Frota com documentação organizada"
          descricao="Quando a empresa tem vários veículos, o problema deixa de ser cada processo e passa a ser o controle: quem vence quando, o que está pendente, qual veículo não pode rodar. A Bradotec centraliza isso junto com a documentação da empresa."
          escuro
        />

        <div class="row justify-content-end gap-7 gap-xl-0">
          <div class="col-xl-4">
            <div
              class="hstack gap-3 flex-wrap"
              data-aos="fade-up"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              <BotaoSeta origem="frota">Falar sobre gestão de frota</BotaoSeta>
              <BotaoSeta href="/empresas" tom="contorno">Ver soluções para empresas</BotaoSeta>
            </div>
          </div>

          <div class="col-xl-4">
            <div
              class="card bg-primary"
              data-aos="fade-up"
              data-aos-delay="200"
              data-aos-duration="1000"
            >
              <div class="card-body d-flex flex-column gap-4">
                <h3 class="mb-0 fs-7">Também cuidamos do resto da empresa</h3>
                <p class="mb-0 fs-4">
                  Muita empresa procura a Bradotec pela frota e descobre que licenças e segurança
                  contra incêndio também estão pendentes. Como é tudo na mesma casa, dá para
                  resolver junto, com um só interlocutor.
                </p>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                  {
                    outrasFrentes.map((frente) => (
                      <li>
                        <a
                          href={frente.href}
                          class="link-hover hstack gap-2 fs-5 fw-bold text-white"
                        >
                          {frente.titulo}
                          <Icone nome="lucide:arrow-up-right" class="fs-6" />
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AcordeaoFaq pagina="documentacao-veicular" numero="04" />
</LayoutStudiova>
