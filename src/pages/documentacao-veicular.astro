---
import fotoPatio from '@/assets/fotos-licenciadas/patio-de-veiculos.jpg'
import BotaoLink from '@/components/BotaoLink.astro'
import BotaoWhatsapp from '@/components/BotaoWhatsapp.astro'
import CabecalhoPagina from '@/components/CabecalhoPagina.astro'
import Faq from '@/components/Faq.astro'
import Kicker from '@/components/Kicker.astro'
import SecaoServicos from '@/components/SecaoServicos.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Documentação veicular', href: '/documentacao-veicular' },
] as const

const schemaFaq = await schemaFaqDaPagina('documentacao-veicular')

/** Venda cruzada: quem chega pela frota costuma ter licenca e incendio pendentes. */
const outrasFrentes = [
  { titulo: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
  { titulo: 'Licenças e regularização', href: '/regularizacoes' },
] as const
---

<BaseLayout
  titulo="Documentação veicular e gestão de frotas em João Pessoa (PB) | Bradotec Auto"
  descricao="Transferência, emplacamento, primeiro registro, segunda via, alteração de dados e regularização de pendências em João Pessoa/PB, além da gestão da documentação de frotas para empresas."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoPatio}
    descricaoDaFoto="Fileira de veículos novos estacionados em um pátio"
    enquadramento="50% 48%"
    cena="fachada"
    titulo="Documentação veicular e frotas"
    subtitulo="Transferência, emplacamento, segunda via e regularização de pendências em João Pessoa. Para empresas, a documentação da frota inteira sob controle."
    trilha={trilha}
  >
    <div class="mt-6 flex flex-wrap gap-3">
      <BotaoLink href="/contato" variante="primario">Resolver documentação do meu veículo</BotaoLink>
    </div>
  </CabecalhoPagina>

  <section class="py-16 lg:py-20" aria-labelledby="intro-auto">
    <div class="mx-auto w-full max-w-wrap px-5">
      <Kicker class="text-div-auto">Bradotec Auto</Kicker>
      <h2 id="intro-auto" class="mt-2 text-secao text-ink">Processos do veículo, conduzidos</h2>
      <p class="mt-4 max-w-[66ch] text-guia text-ink-soft">
        Cada processo tem etapas próprias e pendências que só aparecem no meio do caminho. A
        Bradotec conduz do início ao fim e informa o andamento a cada etapa.
      </p>
    </div>
  </section>

  <SecaoServicos divisao="auto" id="servicos-auto" titulo="Serviços da divisão Auto" />

  <section class="bg-graphite-900 py-16 text-white lg:py-20" aria-labelledby="para-empresas">
    <div class="mx-auto w-full max-w-wrap px-5">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <Kicker class="text-ok-claro">Para empresas</Kicker>
          <h2 id="para-empresas" class="mt-2 max-w-[24ch] text-secao text-white">
            Frota com documentação organizada
          </h2>
          <p class="mt-3 max-w-[68ch] text-sobre-escuro">
            Quando a empresa tem vários veículos, o problema deixa de ser cada processo e passa a
            ser o controle: quem vence quando, o que está pendente, qual veículo não pode rodar. A
            Bradotec centraliza isso junto com a documentação da empresa.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <BotaoWhatsapp origem="frota">Falar sobre gestão de frota</BotaoWhatsapp>
            <BotaoLink href="/empresas" variante="sobreEscuro">Ver soluções para empresas</BotaoLink>
          </div>
        </div>

        <div class="rounded-xl border border-white/12 bg-white/5 p-7">
          <h3 class="text-cartao text-white">Também cuidamos do resto da empresa</h3>
          <p class="mt-3 text-corpo text-sobre-escuro">
            Muita empresa procura a Bradotec pela frota e descobre que licenças e segurança contra
            incêndio também estão pendentes. Como é tudo na mesma casa, dá para resolver junto, com
            um só interlocutor.
          </p>
          <ul class="mt-5 flex list-none flex-col gap-2.5">
            {
              outrasFrentes.map((frente) => (
                <li>
                  <a
                    class="font-bold text-white underline underline-offset-4 hover:text-ok-claro"
                    href={frente.href}
                  >
                    {frente.titulo}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq pagina="documentacao-veicular" />
</BaseLayout>
