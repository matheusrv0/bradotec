---
import BotaoLink from '@/components/BotaoLink.astro'
import CabecalhoPagina from '@/components/CabecalhoPagina.astro'
import Quiz from '@/components/Quiz.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Diagnóstico', href: '/diagnostico' },
] as const
---

<BaseLayout
  titulo="Diagnóstico de Regularização em 4 perguntas | Bradotec"
  descricao="Responda quatro perguntas e descubra por qual divisão da Bradotec o seu caso começa: segurança contra incêndio, licenças e regularização ou documentação veicular. Sem compromisso de contratação."
  trilha={trilha}
>
  <CabecalhoPagina
    cena="fachada"
    titulo="Diagnóstico de Regularização"
    subtitulo="Quatro perguntas para saber por onde o seu caso começa. Serve para direcionar o atendimento. Não substitui a análise da documentação."
    trilha={trilha}
  />

  <section class="py-16 lg:py-20" aria-labelledby="quiz">
    <div class="mx-auto w-full max-w-[820px] px-5">
      <h2 id="quiz" class="sr-only">As quatro perguntas</h2>
      <Quiz />

      <div class="mt-8 rounded-xl border border-line bg-canvas p-6">
        <h2 class="text-cartao text-ink">Prefere falar direto?</h2>
        <p class="mt-2 text-corpo text-ink-soft">
          Se você já sabe o que precisa, não é obrigatório responder o diagnóstico.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <BotaoLink href="/contato">Falar com um especialista</BotaoLink>
          <BotaoLink href="/solucoes">Ver todas as soluções</BotaoLink>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
