---
import { getCollection } from 'astro:content'
import fotoPredios from '@/assets/fotos-geradas/predios-vistos-de-baixo.jpg'
import AcordeaoFaq from '@/components/studiova/AcordeaoFaq.astro'
import Botao from '@/components/studiova/Botao.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import Icone from '@/components/studiova/Icone.astro'
import PainelVencimentos from '@/components/studiova/PainelVencimentos.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Empresas', href: '/empresas' },
] as const

const schemaFaq = await schemaFaqDaPagina('empresas')

const segmentos = (await getCollection('segmentos')).sort((a, b) => a.data.ordem - b.data.ordem)

const gestaoContinua = [
  'Mapeamento inicial de tudo que a operação precisa manter válido',
  'Controle de vencimentos com renovação iniciada com antecedência',
  'Organização e guarda dos documentos atualizados',
  'Acompanhamento de processos e exigências em aberto',
  'Relatórios de situação e orientação administrativa',
] as const
---

<LayoutStudiova
  titulo="Gestão documental para empresas e condomínios em João Pessoa (PB) | Bradotec"
  descricao="Gestão documental contínua para empresas, condomínios, instituições e frotas em João Pessoa/PB: licenças, segurança contra incêndio, controle de vencimentos e acompanhamento de exigências."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoPredios}
    descricaoDaFoto="Edifícios residenciais vistos de baixo ao anoitecer, com algumas janelas acesas"
    enquadramento="50% 50%"
    titulo="Sua empresa regularizada. Seus documentos sob controle."
    subtitulo="Gestão documental contínua para empresas, condomínios e instituições que não podem depender da memória de ninguém para se manter regulares."
    trilha={trilha}
  >
    <Botao href="/contato">Solicitar orçamento</Botao>
  </CabecalhoPagina>

  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao numero="01" etiqueta="Quem atendemos" titulo="Soluções por tipo de operação" />

        <div class="row">
          {
            segmentos.map(({ data }, i) => (
              <div class="col-md-6 col-lg-4 mb-7">
                <div
                  class="d-flex flex-column gap-3 pt-6 border-top h-100"
                  data-aos="fade-up"
                  data-aos-delay={`${((i % 3) + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <h3 class="mb-0 fs-6">{data.titulo}</h3>
                  <p class="mb-0 fs-4">{data.descricao}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="02"
          etiqueta="Contrato recorrente"
          titulo="Como funciona a gestão documental contínua"
          descricao="Em vez de acionar a Bradotec quando o problema aparece, a documentação passa a ser acompanhada o ano inteiro. É o modelo indicado para quem tem mais de uma licença, mais de uma unidade ou responde por um condomínio."
          escuro
        />

        <div class="row justify-content-between gap-7 gap-xl-0 align-items-center">
          <div class="col-xl-5">
            <ul class="list-unstyled mb-0">
              {
                gestaoContinua.map((item, i) => (
                  <li
                    class="py-4 border-top border-white border-opacity-10 hstack gap-4 align-items-start"
                    data-aos="fade-right"
                    data-aos-delay={`${(i + 1) * 100}`}
                    data-aos-duration="1000"
                  >
                    <Icone
                      nome="solar:check-circle-bold"
                      class="fs-6 text-primary flex-shrink-0"
                    />
                    <span class="fs-5 text-white text-opacity-75">{item}</span>
                  </li>
                ))
              }
            </ul>
            <div class="hstack gap-3 flex-wrap mt-7">
              <Botao origem="recorrente">Conhecer a gestão documental</Botao>
              <Botao href="/diagnostico" tom="contorno">Responder as 4 perguntas</Botao>
            </div>
          </div>

          <div class="col-xl-6">
            <div data-aos="fade-left" data-aos-delay="200" data-aos-duration="1000">
              <PainelVencimentos />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AcordeaoFaq pagina="empresas" numero="03" />
</LayoutStudiova>
