---
import { getCollection } from 'astro:content'
import fotoInspecao from '@/assets/fotos-provisorias/inspecao-de-extintores.png'
import AvisoEscopo from '@/components/AvisoEscopo.astro'
import BotaoLink from '@/components/BotaoLink.astro'
import BotaoWhatsapp from '@/components/BotaoWhatsapp.astro'
import CabecalhoPagina from '@/components/CabecalhoPagina.astro'
import Faq from '@/components/Faq.astro'
import Kicker from '@/components/Kicker.astro'
import {
  areaBaseM2,
  emReais,
  leis,
  multaEmReaisPara,
  multaEmUfr,
  multaEmUfrPara,
  type NivelDeRisco,
  ufrPb,
  validadeDaInspecaoEmAnos,
} from '@/config/avcb'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const rotuloDoRisco: Record<NivelDeRisco, string> = {
  baixo: 'baixo risco',
  medio: 'médio risco',
  alto: 'alto risco',
}

/** Exemplo escolhido por ser o caso mais comum entre os clientes: prédio residencial. */
const exemplo = { risco: 'medio', area: 4000 } as const satisfies {
  risco: NivelDeRisco
  area: number
}

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
  { nome: 'AVCB', href: '/avcb' },
] as const

const schemaFaq = await schemaFaqDaPagina('avcb')

const conteudo = await getCollection('avcb')
const doGrupo = (grupo: 'risco' | 'item' | 'cotacao') =>
  conteudo.filter(({ data }) => data.grupo === grupo).sort((a, b) => a.data.ordem - b.data.ordem)

const riscos = doGrupo('risco')
const itens = doGrupo('item')
const cotacao = doGrupo('cotacao')
---

<BaseLayout
  titulo="AVCB: o que é, para que serve e o que é exigido | Bradotec João Pessoa"
  descricao="O que é o AVCB, por que ele é obrigatório, o que costuma ser exigido para obtê-lo e o que está em jogo quando vence, para condomínios, comércios, indústrias e postos de combustível em João Pessoa e região."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoInspecao}
    descricaoDaFoto="Inspeção de extintores em uma casa de máquinas, com prancheta de conferência"
    cena="rota"
    titulo="AVCB: o que é, para que serve e o que costuma ser exigido"
    subtitulo="O documento que atesta que a edificação está em conformidade com as normas de segurança contra incêndio, e o que acontece quando ele vence."
    trilha={trilha}
  >
    <div class="mt-6 flex flex-wrap gap-3">
      <BotaoLink href="/diagnostico" variante="primario">Responder as 4 perguntas</BotaoLink>
    </div>
  </CabecalhoPagina>

  <section class="py-16 lg:py-20" aria-labelledby="o-que-e">
    <div class="mx-auto w-full max-w-wrap px-5">
      <Kicker>Bradotec Fire</Kicker>
      <h2 id="o-que-e" class="mt-2 max-w-[20ch] text-secao text-ink">O que é o AVCB</h2>

      <div class="mt-6 max-w-[68ch] space-y-5 text-guia text-ink-soft">
        <p>
          AVCB é a sigla de <strong class="font-bold text-ink">
            Auto de Vistoria do Corpo de Bombeiros
          </strong>. É o documento emitido pelo Corpo de Bombeiros atestando que a edificação está
          em conformidade com as normas, regras e leis de segurança, prevenção e combate a
          incêndios.
        </p>
        <p>
          A vistoria pode acontecer a pedido do próprio condomínio ou da empresa, por denúncia, ou
          como fiscalização sem aviso. Em alguns tipos de edificação o documento equivalente tem
          outro nome e outro rito, conforme a ocupação, a área e o risco.
        </p>
        <p>
          Não é selo de qualidade nem diferencial: é a condição para a edificação estar regular.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-graphite-900 py-20 text-white lg:py-24" aria-labelledby="em-jogo">
    <div class="mx-auto w-full max-w-wrap px-5">
      <h2 id="em-jogo" class="max-w-[24ch] text-secao text-white">
        O que está em jogo quando o AVCB vence
      </h2>
      <p class="mt-4 max-w-[66ch] text-guia text-sobre-escuro">
        A multa costuma ser a primeira coisa que vem à cabeça, e é a menor delas. O que pesa mais
        aparece depois, e quase sempre no pior momento.
      </p>

      <dl class="mt-12 grid gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {
          riscos.map((risco) => (
            <div class="relative border-t border-white/15 pt-7">
              <span
                class="absolute -top-0.5 left-0 h-[3px] w-9 rounded-full bg-wine"
                aria-hidden="true"
              />
              <dt class="text-cartao-lg text-white">{risco.data.titulo}</dt>
              <dd class="mt-3 text-corpo text-sobre-escuro">{risco.data.descricao}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 flex flex-wrap gap-3">
        <BotaoWhatsapp origem="avcb">Quero resolver o AVCB</BotaoWhatsapp>
        <BotaoLink href="/seguranca-contra-incendio" variante="sobreEscuro">
          Ver a divisão Fire
        </BotaoLink>
      </div>
    </div>
  </section>

  <section class="bg-canvas py-16 lg:py-20" aria-labelledby="exigido">
    <div class="mx-auto w-full max-w-wrap px-5">
      <h2 id="exigido" class="max-w-[22ch] text-secao text-ink">O que costuma ser exigido</h2>
      <p class="mt-4 max-w-[66ch] text-guia text-ink-soft">
        A lista abaixo é o que aparece com mais frequência. A lista definitiva do seu caso sai da
        análise da edificação. Depende da ocupação, da área, do risco e do que o órgão competente
        exigir para aquele tipo de imóvel.
      </p>

      {/*
        Lista, e nao nove cartoes.

        Cartao da a cada item peso de bloco proprio, com borda, sombra e
        respiro em volta. Nove deles viravam nove coisas disputando atencao
        no meio de uma pagina que ja tinha 26 blocos. Mas isto aqui e uma
        lista de conferencia: a pessoa quer PERCORRER, nao contemplar item
        por item. Em lista ocupa menos da metade da altura e le mais rapido.
      */}
      <ul class="mt-9 grid list-none gap-x-10 gap-y-4 border-t border-line pt-8 md:grid-cols-2">
        {
          itens.map((item) => (
            <li>
              <strong class="font-bold text-ink">{item.data.titulo}</strong>
              <span class="text-ink-soft"> {item.data.descricao}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/*
    Os numeros desta secao saem de src/config/avcb.ts, travados por teste.
    Sao dado de lei estadual publicado para sindico e dono de comercio ler:
    errar aqui nao e defeito de layout, e informar errado sobre multa e prazo.

    A multa aparece primeiro em UFR-PB, que a lei fixa e nao muda, e so depois
    em reais com o mes de referencia ao lado — a UFR-PB e corrigida todo mes
    pelo IPCA, entao valor em real sem data envelhece em semanas.
  */}
  <section class="py-16 lg:py-20" aria-labelledby="prazo-multa">
    <div class="mx-auto w-full max-w-wrap px-5">
      <Kicker>Base legal na Paraíba</Kicker>
      <h2 id="prazo-multa" class="mt-2 max-w-[24ch] text-secao text-ink">
        Quanto vale a multa e por quanto tempo vale o AVCB
      </h2>
      <p class="mt-4 max-w-[70ch] text-guia text-ink-soft">
        Quase todo texto sobre AVCB que circula na internet é de São Paulo, e fala em validade de
        três a cinco anos e multa que passa de R$ 200 mil. Nenhum dos dois números vale aqui: os
        dois são definidos por legislação estadual. Na Paraíba, quem manda é a{' '}
        <a class="font-bold text-wine" href={leis.base.url} target="_blank" rel="noopener">
          {leis.base.rotulo}
        </a>, alterada pela{' '}
        <a class="font-bold text-wine" href={leis.alteracao.url} target="_blank" rel="noopener">
          {leis.alteracao.rotulo}
        </a>.
      </p>

      <div class="mt-11 grid gap-6 lg:grid-cols-2">
        <div class="rounded-xl border border-line bg-white p-7 shadow-card">
          <h3 class="text-cartao-lg text-ink">O AVCB da Paraíba vale 1 ano</h3>
          <p class="mt-3 text-ink-soft">
            É anual, e não de três a cinco anos (art. 3º-A, § 1º). O que se repete no intervalo
            mais longo é a <strong class="font-bold text-ink">vistoria completa</strong>, cujo
            prazo depende do risco da edificação (art. 15-A, I):
          </p>

          <dl class="mt-5 divide-y divide-line-soft border-y border-line-soft">
            {
              (['baixo', 'medio', 'alto'] as const).map((risco) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-corpo text-ink-soft">Edificação de {rotuloDoRisco[risco]}</dt>
                  <dd class="text-cartao font-bold text-ink" data-numerico>
                    {validadeDaInspecaoEmAnos[risco]}
                    {validadeDaInspecaoEmAnos[risco] === 1 ? ' ano' : ' anos'}
                  </dd>
                </div>
              ))
            }
          </dl>

          <p class="mt-5 text-corpo text-ink-soft">
            Entre uma vistoria e outra, a renovação anual do documento é feita pela
            <strong class="font-bold text-ink"> RAS, a Renovação Anual Simplificada</strong>, nas
            edificações de baixo e médio risco. Ela é declarada pelo proprietário, com firma
            reconhecida, assumindo responsabilidade pela manutenção dos sistemas.
          </p>
        </div>

        <div class="rounded-xl border border-line bg-white p-7 shadow-card">
          <h3 class="text-cartao-lg text-ink">A multa é medida em UFR-PB</h3>
          <p class="mt-3 text-ink-soft">
            O art. 25, § 6º fixa a multa por nível de risco. O § 7º acrescenta
            <strong class="font-bold text-ink"> 0,05 UFR-PB por metro quadrado</strong> acima de
            {' '}{areaBaseM2} m². É isso que faz a multa de um prédio ser muito maior que a de
            uma sala comercial.
          </p>

          <table class="mt-5 w-full border-collapse text-corpo">
            <caption class="sr-only">
              Multa por nível de risco, em UFR-PB e em reais
            </caption>
            <thead>
              <tr class="border-b border-line text-left text-rotulo uppercase tracking-[0.06em] text-ash-500">
                <th class="py-2 font-bold" scope="col">Risco</th>
                <th class="py-2 text-right font-bold" scope="col">UFR-PB</th>
                <th class="py-2 text-right font-bold" scope="col">Equivalente</th>
              </tr>
            </thead>
            <tbody>
              {
                (['baixo', 'medio', 'alto'] as const).map((risco) => (
                  <tr class="border-b border-line-soft">
                    <th class="py-3 text-left font-normal text-ink-soft" scope="row">
                      {rotuloDoRisco[risco]}
                    </th>
                    <td class="py-3 text-right font-bold text-ink" data-numerico>
                      {multaEmUfr[risco]}
                    </td>
                    <td class="py-3 text-right text-ink" data-numerico>
                      {emReais(multaEmUfr[risco] * ufrPb.valor)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <p class="mt-4 text-apoio text-ash-500">
            Valores de base, para até {areaBaseM2} m². Equivalência calculada pela UFR-PB de {
              ufrPb.mes
            }, de {emReais(ufrPb.valor)}. O índice é corrigido todo mês pelo IPCA, então o valor
            em reais muda; o valor em UFR-PB, não.
          </p>
        </div>
      </div>

      <div class="mt-6 rounded-xl border-l-4 border-l-wine border-y border-r border-line bg-white p-7 shadow-card">
        <h3 class="text-cartao font-bold text-ink">Onde a conta cresce</h3>
        <p class="mt-3 max-w-[76ch] text-ink-soft">
          Um condomínio de {exemplo.area.toLocaleString('pt-BR')} m² classificado como
          {' '}{rotuloDoRisco[exemplo.risco]} não paga as {multaEmUfr[exemplo.risco]} UFR-PB de
          base: paga {multaEmUfrPara(exemplo.risco, exemplo.area).toLocaleString('pt-BR')} UFR-PB,
          porque {(exemplo.area - areaBaseM2).toLocaleString('pt-BR')} m² excedem a faixa base,
          cerca de {emReais(multaEmReaisPara(exemplo.risco, exemplo.area))} pela UFR-PB de {
            ufrPb.mes
          }. E a multa é a consequência mais barata: interdição, embargo e recusa de seguro não
          têm teto.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-canvas py-16 lg:py-20" aria-labelledby="cotacao">
    <div class="mx-auto w-full max-w-wrap px-5">
      <h2 id="cotacao" class="max-w-[26ch] text-secao text-ink">
        O que perguntar antes de contratar
      </h2>
      <p class="mt-4 max-w-[68ch] text-guia text-ink-soft">
        Quatro perguntas que separam orçamento comparável de orçamento que só parece mais barato.
        Use com qualquer fornecedor, inclusive conosco.
      </p>

      <ol class="mt-11 grid list-none gap-4 md:grid-cols-2">
        {
          cotacao.map((pergunta, indice) => (
            <li class="flex gap-4 rounded-xl border border-line bg-white p-5 shadow-card">
              <span
                class="flex size-7 shrink-0 items-center justify-center rounded-full bg-graphite-900 text-rotulo font-bold text-white"
                aria-hidden="true"
              >
                {indice + 1}
              </span>
              <div>
                <p class="text-cartao font-bold text-ink">{pergunta.data.titulo}</p>
                <p class="mt-2 text-corpo text-ink-soft">{pergunta.data.descricao}</p>
              </div>
            </li>
          ))
        }
      </ol>

      {/*
        Ponteiro, e nao copia. As quatro perguntas acima ajudam a avaliar quem
        ja apareceu; a secao ligada aqui explica de que profissao e conduzir o
        processo, e por lei. Repetir aquele texto aqui faria duas paginas
        disputarem a mesma busca, que e o erro que /carregadores-eletricos e o
        artigo cometeram.
      */}
      <p class="mt-8">
        <a
          class="group inline-flex items-center gap-2 font-bold text-wine"
          href="/seguranca-contra-incendio#por-que-despachante"
        >
          Por que conduzir esse processo é trabalho de despachante documentalista
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="shrink-0 transition-[translate] duration-200 ease-saida group-hover:translate-x-1"
          >
            <path d="M5 12h13m-5-6 6 6-6 6"></path>
          </svg>
        </a>
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20" aria-labelledby="nao-sei">
    <div class="mx-auto w-full max-w-wrap px-5">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 id="nao-sei" class="text-cartao-lg text-ink">
            Não sabe em que estágio o seu caso está?
          </h2>
          <p class="mt-2 max-w-[58ch] text-ink-soft">
            O Diagnóstico de Regularização são quatro perguntas. Não substitui a análise
            documental: mostra por onde começa.
          </p>
        </div>
        <div class="shrink-0">
          <BotaoLink href="/diagnostico">Responder as 4 perguntas</BotaoLink>
        </div>
      </div>
    </div>
  </section>

  <AvisoEscopo titulo="O que a Bradotec faz e o que é feito por terceiros">
    A Bradotec atua na gestão documental, na condução administrativa e no acompanhamento do
    processo junto ao órgão competente. Projeto técnico, laudos, instalação e manutenção de
    sistemas preventivos exigem habilitação específica e são executados por profissionais e
    empresas legalmente habilitados, com quem a Bradotec coordena o trabalho. Prazos de análise,
    vistoria e aprovação dependem do Corpo de Bombeiros. Esta página é informativa e não substitui
    a análise da sua edificação nem orientação jurídica.
  </AvisoEscopo>

  <Faq pagina="avcb" titulo="Perguntas frequentes sobre AVCB" />
</BaseLayout>
