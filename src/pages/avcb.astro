---
import { getCollection } from 'astro:content'
import fotoInspecao from '@/assets/fotos-licenciadas/extintores-e-sinalizacao.jpg'
import AcordeaoFaq from '@/components/studiova/AcordeaoFaq.astro'
import AvisoEscopo from '@/components/studiova/AvisoEscopo.astro'
import BotaoSeta from '@/components/studiova/BotaoSeta.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import {
  areaBaseM2,
  emReais,
  leis,
  multaEmReaisPara,
  multaEmUfr,
  multaEmUfrPara,
  type NivelDeRisco,
  ufrPb,
  validadeDaInspecaoEmAnos,
} from '@/config/avcb'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const rotuloDoRisco: Record<NivelDeRisco, string> = {
  baixo: 'baixo risco',
  medio: 'médio risco',
  alto: 'alto risco',
}

/** Exemplo escolhido por ser o caso mais comum entre os clientes: prédio residencial. */
const exemplo = { risco: 'medio', area: 4000 } as const satisfies {
  risco: NivelDeRisco
  area: number
}

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
  { nome: 'AVCB', href: '/avcb' },
] as const

const schemaFaq = await schemaFaqDaPagina('avcb')

const conteudo = await getCollection('avcb')
const doGrupo = (grupo: 'risco' | 'item' | 'cotacao') =>
  conteudo.filter(({ data }) => data.grupo === grupo).sort((a, b) => a.data.ordem - b.data.ordem)

const riscos = doGrupo('risco')
const itens = doGrupo('item')
const cotacao = doGrupo('cotacao')

const niveis = ['baixo', 'medio', 'alto'] as const
---

<LayoutStudiova
  titulo="AVCB: o que é, para que serve e o que é exigido | Bradotec João Pessoa"
  descricao="O que é o AVCB, por que ele é obrigatório, o que costuma ser exigido para obtê-lo e o que está em jogo quando vence, para condomínios, comércios, indústrias e postos de combustível em João Pessoa e região."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoInspecao}
    descricaoDaFoto="Dois extintores junto a uma parede escura, sob placas de sinalização de extintor e de gás inflamável"
    enquadramento="50% 80%"
    titulo="AVCB: o que é, para que serve e o que costuma ser exigido"
    subtitulo="O documento que atesta que a edificação está em conformidade com as normas de segurança contra incêndio, e o que acontece quando ele vence."
    trilha={trilha}
  >
    <BotaoSeta href="/diagnostico">Responder as 4 perguntas</BotaoSeta>
  </CabecalhoPagina>

  <!-- 01 — O que é -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao numero="01" etiqueta="Bradotec Fire" titulo="O que é o AVCB" />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <div
              class="d-flex flex-column gap-4"
              data-aos="fade-up"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              <p class="mb-0 fs-5">
                AVCB é a sigla de <strong class="text-dark">Auto de Vistoria do Corpo de
                Bombeiros</strong>. É o documento emitido pelo Corpo de Bombeiros atestando que a
                edificação está em conformidade com as normas, regras e leis de segurança,
                prevenção e combate a incêndios.
              </p>
              <p class="mb-0 fs-5">
                A vistoria pode acontecer a pedido do próprio condomínio ou da empresa, por
                denúncia, ou como fiscalização sem aviso. Em alguns tipos de edificação o documento
                equivalente tem outro nome e outro rito, conforme a ocupação, a área e o risco.
              </p>
              <p class="mb-0 fs-5">
                Não é selo de qualidade nem diferencial: é a condição para a edificação estar
                regular.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — O que está em jogo -->
  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="02"
          etiqueta="O que está em jogo"
          titulo="O que está em jogo quando o AVCB vence"
          descricao="A multa costuma ser a primeira coisa que vem à cabeça, e é a menor delas. O que pesa mais aparece depois, e quase sempre no pior momento."
          escuro
        />

        <div class="row">
          {
            riscos.map(({ data }, i) => (
              <div class="col-md-6 col-lg-4 mb-7">
                <div
                  class="d-flex flex-column gap-4 pt-7 border-top border-white border-opacity-10 h-100"
                  data-aos="fade-up"
                  data-aos-delay={`${((i % 3) + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <iconify-icon icon="solar:danger-triangle-bold" class="fs-10 text-primary" />
                  <h3 class="mb-0 fs-6 text-white">{data.titulo}</h3>
                  <p class="mb-0 fs-4 text-white text-opacity-70">{data.descricao}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="hstack gap-3 flex-wrap">
          <BotaoSeta origem="avcb">Quero resolver o AVCB</BotaoSeta>
          <BotaoSeta href="/seguranca-contra-incendio" tom="contorno">Ver a divisão Fire</BotaoSeta>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — O que é exigido -->
  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="03"
          etiqueta="Documentação"
          titulo="O que costuma ser exigido"
          descricao="A lista abaixo é o que aparece com mais frequência. A lista definitiva do seu caso sai da análise da edificação. Depende da ocupação, da área, do risco e do que o órgão competente exigir para aquele tipo de imóvel."
        />

        {/*
          Lista, e nao nove cartoes: e uma lista de conferencia, e a pessoa
          quer percorrer, nao contemplar item por item.
        */}
        <div class="row justify-content-end">
          <div class="col-xl-9">
            <ul class="list-unstyled mb-0 border-top">
              {
                itens.map(({ data }, i) => (
                  <li
                    class="py-4 border-bottom"
                    data-aos="fade-up"
                    data-aos-delay={`${((i % 4) + 1) * 80}`}
                    data-aos-duration="800"
                  >
                    <strong class="text-dark fs-5">{data.titulo}</strong>
                    <span class="fs-4"> {data.descricao}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/*
    04 — Base legal.
    Os numeros desta secao saem de src/config/avcb.ts, travados por teste.
    Sao dado de lei estadual publicado para sindico e dono de comercio ler:
    errar aqui nao e defeito de layout, e informar errado sobre multa e prazo.

    A multa aparece primeiro em UFR-PB, que a lei fixa e nao muda, e so depois
    em reais com o mes de referencia ao lado — a UFR-PB e corrigida todo mes
    pelo IPCA, entao valor em real sem data envelhece em semanas.
  */}
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="04"
          etiqueta="Base legal na Paraíba"
          titulo="Quanto vale a multa e por quanto tempo vale o AVCB"
        />

        <div class="row justify-content-end">
          <div class="col-xl-9">
            <p
              class="mb-0 fs-5"
              data-aos="fade-up"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              Quase todo texto sobre AVCB que circula na internet é de São Paulo, e fala em
              validade de três a cinco anos e multa que passa de R$ 200 mil. Nenhum dos dois
              números vale aqui: os dois são definidos por legislação estadual. Na Paraíba, quem
              manda é a <a class="fw-bold text-primary" href={leis.base.url} target="_blank" rel="noopener">{leis.base.rotulo}</a>,
              alterada pela <a class="fw-bold text-primary" href={leis.alteracao.url} target="_blank" rel="noopener">{leis.alteracao.rotulo}</a>.
            </p>
          </div>
        </div>

        <div class="row">
          <div class="col-lg-6 mb-7 mb-lg-0">
            <div
              class="card border bg-white h-100"
              data-aos="fade-up"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              <div class="card-body d-flex flex-column gap-4">
                <h3 class="mb-0 fs-7">O AVCB da Paraíba vale 1 ano</h3>
                <p class="mb-0 fs-4">
                  É anual, e não de três a cinco anos (art. 3º-A, § 1º). O que se repete no
                  intervalo mais longo é a <strong class="text-dark">vistoria completa</strong>,
                  cujo prazo depende do risco da edificação (art. 15-A, I):
                </p>

                <dl class="mb-0 border-top">
                  {
                    niveis.map((risco) => (
                      <div class="hstack justify-content-between gap-4 py-3 border-bottom">
                        <dt class="fw-normal fs-4">Edificação de {rotuloDoRisco[risco]}</dt>
                        <dd class="mb-0 fs-5 fw-bold text-dark">
                          {validadeDaInspecaoEmAnos[risco]}
                          {validadeDaInspecaoEmAnos[risco] === 1 ? ' ano' : ' anos'}
                        </dd>
                      </div>
                    ))
                  }
                </dl>

                <p class="mb-0 fs-4">
                  Entre uma vistoria e outra, a renovação anual do documento é feita pela
                  <strong class="text-dark"> RAS, a Renovação Anual Simplificada</strong>, nas
                  edificações de baixo e médio risco. Ela é declarada pelo proprietário, com firma
                  reconhecida, assumindo responsabilidade pela manutenção dos sistemas.
                </p>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div
              class="card border bg-white h-100"
              data-aos="fade-up"
              data-aos-delay="200"
              data-aos-duration="1000"
            >
              <div class="card-body d-flex flex-column gap-4">
                <h3 class="mb-0 fs-7">A multa é medida em UFR-PB</h3>
                <p class="mb-0 fs-4">
                  O art. 25, § 6º fixa a multa por nível de risco. O § 7º acrescenta
                  <strong class="text-dark"> 0,05 UFR-PB por metro quadrado</strong> acima de {
                    areaBaseM2
                  } m². É isso que faz a multa de um prédio ser muito maior que a de uma sala
                  comercial.
                </p>

                <div class="table-responsive">
                  <table class="table mb-0 align-middle">
                    <caption class="visually-hidden">
                      Multa por nível de risco, em UFR-PB e em reais
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col" class="fs-3 text-uppercase text-muted">Risco</th>
                        <th scope="col" class="fs-3 text-uppercase text-muted text-end">UFR-PB</th>
                        <th scope="col" class="fs-3 text-uppercase text-muted text-end">
                          Equivalente
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {
                        niveis.map((risco) => (
                          <tr>
                            <th scope="row" class="fw-normal fs-4">
                              {rotuloDoRisco[risco]}
                            </th>
                            <td class="text-end fw-bold text-dark fs-4">{multaEmUfr[risco]}</td>
                            <td class="text-end fs-4">
                              {emReais(multaEmUfr[risco] * ufrPb.valor)}
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>

                <p class="mb-0 fs-3 text-muted">
                  Valores de base, para até {areaBaseM2} m². Equivalência calculada pela UFR-PB de {
                    ufrPb.mes
                  }, de {emReais(ufrPb.valor)}. O índice é corrigido todo mês pelo IPCA, então o
                  valor em reais muda; o valor em UFR-PB, não.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div
          class="card bg-primary"
          data-aos="fade-up"
          data-aos-delay="100"
          data-aos-duration="1000"
        >
          <div class="card-body d-flex flex-column gap-3">
            <h3 class="mb-0 fs-7">Onde a conta cresce</h3>
            <p class="mb-0 fs-4">
              Um condomínio de {exemplo.area.toLocaleString('pt-BR')} m² classificado como {
                rotuloDoRisco[exemplo.risco]
              } não paga as {multaEmUfr[exemplo.risco]} UFR-PB de base: paga {
                multaEmUfrPara(exemplo.risco, exemplo.area).toLocaleString('pt-BR')
              } UFR-PB, porque {(exemplo.area - areaBaseM2).toLocaleString('pt-BR')} m² excedem a
              faixa base, cerca de {emReais(multaEmReaisPara(exemplo.risco, exemplo.area))} pela
              UFR-PB de {ufrPb.mes}. E a multa é a consequência mais barata: interdição, embargo e
              recusa de seguro não têm teto.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 — O que perguntar -->
  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="05"
          etiqueta="Antes de contratar"
          titulo="O que perguntar antes de contratar"
          descricao="Quatro perguntas que separam orçamento comparável de orçamento que só parece mais barato. Use com qualquer fornecedor, inclusive conosco."
        />

        <div class="row">
          {
            cotacao.map(({ data }, i) => (
              <div class="col-md-6 mb-7">
                <div
                  class="d-flex gap-4 align-items-start pt-6 border-top h-100"
                  data-aos="fade-up"
                  data-aos-delay={`${((i % 2) + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <span class="round-36 flex-shrink-0 rounded-circle bg-dark text-white hstack justify-content-center fw-bold fs-3">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="mb-2 fs-6">{data.titulo}</h3>
                    <p class="mb-0 fs-4">{data.descricao}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        {/*
          Ponteiro, e nao copia. As quatro perguntas acima ajudam a avaliar
          quem ja apareceu; a secao ligada aqui explica de que profissao e
          conduzir o processo, e por lei.
        */}
        <div class="row justify-content-end">
          <div class="col-xl-9">
            <a
              class="link-hover hstack gap-2 fs-5 fw-bold text-primary w-fit"
              href="/seguranca-contra-incendio#por-que-despachante"
            >
              Por que conduzir esse processo é trabalho de despachante documentalista
              <iconify-icon icon="lucide:arrow-up-right" class="fs-6 flex-shrink-0" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 — Não sabe em que estágio está -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div
        class="card bg-dark"
        data-aos="fade-up"
        data-aos-delay="100"
        data-aos-duration="1000"
      >
        <div class="card-body">
          <div class="row align-items-center gap-4 gap-md-0">
            <div class="col-md-8">
              <h2 class="mb-2 fs-8 text-white">Não sabe em que estágio o seu caso está?</h2>
              <p class="mb-0 fs-4 text-white text-opacity-70">
                O Diagnóstico de Regularização são quatro perguntas. Não substitui a análise
                documental: mostra por onde começa.
              </p>
            </div>
            <div class="col-md-4 d-flex justify-content-md-end">
              <BotaoSeta href="/diagnostico">Responder as 4 perguntas</BotaoSeta>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AvisoEscopo titulo="O que a Bradotec faz e o que é feito por terceiros">
    A Bradotec atua na gestão documental, na condução administrativa e no acompanhamento do
    processo junto ao órgão competente. Projeto técnico, laudos, instalação e manutenção de
    sistemas preventivos exigem habilitação específica e são executados por profissionais e
    empresas legalmente habilitados, com quem a Bradotec coordena o trabalho. Prazos de análise,
    vistoria e aprovação dependem do Corpo de Bombeiros. Esta página é informativa e não substitui
    a análise da sua edificação nem orientação jurídica.
  </AvisoEscopo>

  <AcordeaoFaq pagina="avcb" numero="07" titulo="Perguntas frequentes sobre AVCB" />
</LayoutStudiova>
