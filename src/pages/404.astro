---
import BotaoSeta from '@/components/studiova/BotaoSeta.astro'
import Icone from '@/components/studiova/Icone.astro'
import { navegacaoPrincipal } from '@/config/navegacao'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'

/**
 * O cabecalho do template usa a marca branca sobre o banner escuro. Como esta
 * pagina nao tem banner, a primeira secao precisa ser escura — senao a marca
 * some no topo.
 */
---

<LayoutStudiova
  titulo="Página não encontrada | Bradotec"
  descricao="A página que você procurava não existe ou mudou de endereço."
  naoIndexar
>
  <section class="bg-dark pb-5 pb-lg-11 pb-xl-12 secao-404">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xl-8 text-center">
          <div
            class="d-flex flex-column gap-6 align-items-center"
            data-aos="fade-up"
            data-aos-delay="100"
            data-aos-duration="1000"
          >
            <span class="badge bg-primary">Erro 404</span>
            <h1 class="mb-0 fs-13 text-white">Esta página não existe.</h1>
            <p class="mb-0 fs-5 text-white text-opacity-75">
              O endereço pode ter mudado ou o link estar incorreto. Você pode voltar ao início ou
              ir direto para uma das soluções.
            </p>
            <div class="hstack gap-3 flex-wrap justify-content-center">
              <BotaoSeta href="/">Voltar ao início</BotaoSeta>
              <BotaoSeta origem="padrao" tom="contorno">Falar no WhatsApp</BotaoSeta>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray">
    <div class="container">
      <div class="row">
        {
          navegacaoPrincipal.map((item, i) => (
            <div class="col-md-6 col-lg-4 mb-6">
              <a
                href={item.href}
                class="card border bg-white text-decoration-none h-100"
                data-aos="fade-up"
                data-aos-delay={`${((i % 3) + 1) * 100}`}
                data-aos-duration="1000"
              >
                <div class="card-body hstack justify-content-between gap-4 py-6">
                  <span class="fs-5 fw-bold text-dark">{item.completo}</span>
                  <Icone
                    nome="lucide:arrow-up-right"
                    class="fs-6 text-primary flex-shrink-0"
                  />
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</LayoutStudiova>

<style>
  .secao-404 {
    padding-top: 200px;
  }
</style>
