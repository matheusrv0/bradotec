---
import BotaoWhatsapp from '@/components/BotaoWhatsapp.astro'
import { navegacaoPrincipal } from '@/config/navegacao'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  titulo="Página não encontrada | Bradotec"
  descricao="A página que você procurava não existe ou mudou de endereço."
  naoIndexar
>
  <section class="py-20">
    <div class="mx-auto w-full max-w-[820px] px-5">
      <p class="mb-3 text-apoio font-bold text-wine">Erro 404</p>
      <h1 class="text-pagina">Esta página não existe.</h1>
      <p class="mt-3 text-ink-soft">
        O endereço pode ter mudado ou o link estar incorreto. Você pode voltar ao início ou ir
        direto para uma das soluções:
      </p>

      <ul class="mt-7 grid gap-2.5 sm:grid-cols-2">
        {
          navegacaoPrincipal.map((item) => (
            <li>
              <a
                class="block rounded-lg border border-line bg-white px-4 py-3.5 font-bold text-graphite-900 no-underline transition-colors hover:border-graphite-700"
                href={item.href}
              >
                {item.completo}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-7 flex flex-wrap gap-3">
        <BotaoWhatsapp origem="padrao">Falar no WhatsApp</BotaoWhatsapp>
        <a
          class="inline-flex min-h-[50px] items-center justify-center rounded-md border border-line-forte px-6 py-3.5 font-bold text-graphite-900 no-underline hover:bg-line-soft"
          href="/"
        >
          Voltar ao início
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
