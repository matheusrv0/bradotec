---
import { getCollection } from 'astro:content'
import fotoFachada from '@/assets/fotos-licenciadas/fachada-de-edificio.jpg'
import AvisoEscopo from '@/components/studiova/AvisoEscopo.astro'
import BotaoSeta from '@/components/studiova/BotaoSeta.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import DadoPendente from '@/components/studiova/DadoPendente.astro'
import Lideranca from '@/components/studiova/Lideranca.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import { enderecoCompleto, site } from '@/config/site'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'
import { jsonLdPessoa } from '@/lib/seo'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'A Bradotec', href: '/sobre' },
] as const

const siteUrl = Astro.site?.href ?? 'https://dominio-do-cliente.example/'
const [pessoa] = (await getCollection('lideranca')).sort((a, b) => a.data.ordem - b.data.ordem)
const schemaPessoa = pessoa ? jsonLdPessoa(pessoa.data, siteUrl) : undefined

/** Os quatro princípios, nas palavras do cliente. */
const comoTrabalhamos = [
  {
    icone: 'solar:user-check-rounded-line-duotone',
    titulo: 'Um responsável',
    descricao: 'Um número para ligar, em vez de juntar as peças sozinho.',
  },
  {
    icone: 'solar:radar-2-line-duotone',
    titulo: 'Antecipação',
    descricao: 'Conhecemos o que será exigido antes de virar exigência.',
  },
  {
    icone: 'solar:refresh-circle-line-duotone',
    titulo: 'Continuidade',
    descricao:
      'Não entregamos o documento e desaparecemos. Mantemos o calendário de conformidade da edificação e avisamos antes de cada vencimento.',
  },
  {
    icone: 'solar:eye-scan-line-duotone',
    titulo: 'Transparência',
    descricao: 'Você sabe em que etapa o processo está, o que falta e qual o prazo.',
  },
] as const

/**
 * O que a Bradotec faz, em lista corrida.
 *
 * Nao substitui /solucoes, que detalha as tres divisoes. Aqui e o resumo do
 * que a empresa executa, para quem chegou nesta pagina querendo saber se o
 * caso dele cabe.
 */
const oQueFazemos = [
  { texto: 'Regularização junto ao Corpo de Bombeiros e renovação de AVCB', href: '/avcb' },
  { texto: 'Laudo de SPDA' },
  { texto: 'Treinamento de brigada de incêndio', href: '/treinamentos' },
  { texto: 'Adequação de extintores, sinalização e iluminação de emergência' },
  {
    texto: 'Regularização de carregadores de veículos elétricos conforme a NT 040/2025',
    href: '/carregadores-eletricos',
  },
  { texto: 'Gestão do calendário de conformidade da edificação', href: '/empresas' },
] as const

const dadosDaEmpresa = [
  { icone: 'lucide:map-pin', rotulo: 'Endereço', valor: enderecoCompleto },
  { icone: 'lucide:clock', rotulo: 'Atendimento', valor: site.horario },
  { icone: 'lucide:file-text', rotulo: 'CNPJ', valor: site.cnpj },
  { icone: 'lucide:phone', rotulo: 'Telefone', valor: site.telefone },
] as const
---

<LayoutStudiova
  titulo={`A ${site.nome}: despachadoria e soluções documentais em ${site.cidade} (${site.estado})`}
  descricao="A Bradotec reúne gestão documental, regularização, licenciamento e segurança contra incêndio em um só interlocutor, para empresas, condomínios, instituições e frotas em João Pessoa e região."
  trilha={trilha}
  schemasExtras={schemaPessoa ? [schemaPessoa] : []}
>
  <CabecalhoPagina
    foto={fotoFachada}
    descricaoDaFoto="Fachada de um edifício comercial vista de baixo, contra o céu"
    enquadramento="50% 40%"
    titulo="A Bradotec"
    subtitulo="Uma central de soluções documentais em João Pessoa: gestão, regularização, licenciamento e segurança contra incêndio reunidos em um só interlocutor."
    trilha={trilha}
  >
    <BotaoSeta origem="padrao">Falar com um especialista</BotaoSeta>
  </CabecalhoPagina>

  <!-- 01 — Por que existe -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao numero="01" etiqueta="A origem" titulo="Por que a Bradotec existe" />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <div
              class="d-flex flex-column gap-4"
              data-aos="fade-up"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              <p class="mb-0 fs-5">
                A Bradotec nasceu de uma constatação simples: a maior parte dos condomínios de {
                  site.cidade
                } não está irregular por má vontade, e sim porque ninguém acompanha. O projeto é
                feito, o processo é protocolado, e depois cada um segue seu caminho. Quando a
                fiscalização chega ou o alvará é negado, o síndico descobre sozinho que algo
                venceu.
              </p>
              <p class="mb-0 fs-5">
                Nosso trabalho é impedir que isso aconteça. Conduzimos a regularização do início ao
                fim e continuamos acompanhando depois dela, mantendo o controle de todos os
                vencimentos da edificação e avisando com antecedência.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Lideranca numero="02" />

  <!-- 03 — Rede técnica -->
  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="03"
          etiqueta="Execução"
          titulo="Nossa rede técnica"
          descricao="Os serviços que exigem responsável técnico habilitado são executados por profissionais registrados: engenheiros, eletricistas e empresas especializadas em sistemas de proteção contra incêndio."
          escuro
        />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <p
              class="mb-0 fs-5 text-white destaque-rede"
              data-aos="fade-up"
              data-aos-delay="200"
              data-aos-duration="1000"
            >
              A diferença é que o síndico não precisa coordenar ninguém. Quem articula a rede,
              acompanha a execução e responde pelo prazo é a Bradotec.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — Como trabalhamos -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao numero="04" etiqueta="Princípios" titulo="Como trabalhamos" />

        <div class="row">
          {
            comoTrabalhamos.map((item, i) => (
              <div class="col-md-6 col-lg-3 mb-7 mb-lg-0">
                <div
                  class="d-flex flex-column gap-5 pt-8 border-top h-100"
                  data-aos="fade-up"
                  data-aos-delay={`${(i + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <iconify-icon icon={item.icone} class="fs-12 text-primary" />
                  <h3 class="mb-0 fs-6">{item.titulo}</h3>
                  <p class="mb-0 fs-4">{item.descricao}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 05 — O que fazemos -->
  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="05"
          etiqueta="Escopo"
          titulo="O que fazemos"
          descricao="A atuação se organiza em três divisões: Fire, Documentos e Auto."
        />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <ul class="list-unstyled mb-0 border-top">
              {
                oQueFazemos.map((item, i) => (
                  <li
                    class="py-4 border-bottom hstack gap-4 align-items-start"
                    data-aos="fade-up"
                    data-aos-delay={`${(i + 1) * 80}`}
                    data-aos-duration="800"
                  >
                    <iconify-icon
                      icon="solar:check-circle-bold"
                      class="fs-6 text-primary flex-shrink-0"
                    />
                    {
                      'href' in item ? (
                        <a class="fs-5 fw-bold text-dark link-hover" href={item.href}>
                          {item.texto}
                        </a>
                      ) : (
                        <span class="fs-5">{item.texto}</span>
                      )
                    }
                  </li>
                ))
              }
            </ul>

            <div class="mt-7">
              <BotaoSeta href="/solucoes">Ver todas as soluções</BotaoSeta>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 — Onde atuamos -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="06"
          etiqueta="Dados da empresa"
          titulo="Onde atuamos"
          descricao={`Base em ${site.cidade}, ${site.estado}, com atendimento em ${site.regiaoAtendida}.`}
        />

        <div class="row">
          {
            dadosDaEmpresa.map((dado, i) => (
              <div class="col-md-6 col-lg-3 mb-6">
                <div
                  class="card border h-100 bg-white"
                  data-aos="fade-up"
                  data-aos-delay={`${(i + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <div class="card-body d-flex flex-column gap-3 p-6">
                    <iconify-icon icon={dado.icone} class="fs-9 text-primary" />
                    <p class="mb-0 fs-3 fw-bold text-uppercase text-muted">{dado.rotulo}</p>
                    <p class="mb-0 fs-4 text-dark">
                      <DadoPendente valor={dado.valor} />
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <p class="mb-0 fs-3 text-muted">
          Histórico da empresa, ano de fundação, demais integrantes da equipe e números de
          atendimento não foram informados e, por isso, não foram criados. Assim que forem
          enviados, entram nesta página.
        </p>
      </div>
    </div>
  </section>

  <AvisoEscopo titulo="Limites da nossa atuação">
    A Bradotec atua na gestão documental e na condução administrativa dos processos. Projetos,
    laudos, serviços técnicos e instalação de sistemas preventivos exigem habilitação específica e
    são executados por profissionais e empresas legalmente habilitados. Prazos e decisões de
    análise, vistoria e aprovação são de responsabilidade dos órgãos competentes.
  </AvisoEscopo>

  <!-- 07 — Fechamento -->
  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="row">
        <div class="col-xl-8">
          <div
            class="d-flex flex-column gap-4"
            data-aos="fade-up"
            data-aos-delay="100"
            data-aos-duration="1000"
          >
            <h2 class="mb-0 text-white">Quer saber o que está vencido no seu condomínio?</h2>
            <p class="mb-3 fs-5 text-white text-opacity-75">
              A conversa inicial serve exatamente para isso, sem compromisso de contratação.
            </p>
            <div class="hstack gap-3 flex-wrap">
              <BotaoSeta origem="condominio">Falar no WhatsApp</BotaoSeta>
              <BotaoSeta href="/diagnostico" tom="contorno">Responder as 4 perguntas</BotaoSeta>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</LayoutStudiova>

<style>
  .destaque-rede {
    border-left: 3px solid var(--brad-brasa);
    padding-left: 20px;
  }
</style>
