---
import fotoSaida from '@/assets/fotos-licenciadas/saida-de-emergencia.jpg'
import AcordeaoFaq from '@/components/studiova/AcordeaoFaq.astro'
import AvisoEscopo from '@/components/studiova/AvisoEscopo.astro'
import BotaoSeta from '@/components/studiova/BotaoSeta.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import SecaoServicos from '@/components/studiova/SecaoServicos.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import {
  atribuicoes,
  condicoesParaExercer,
  leiDaProfissao,
  semDespachante,
} from '@/config/despachante'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
] as const

const schemaFaq = await schemaFaqDaPagina('seguranca-contra-incendio')

/** O custo de deixar a pendencia aberta. Fatos, sem promessa de resultado. */
const riscos = [
  'Renovação de alvará e de licenças travada por falta do documento de incêndio',
  'Exigências acumuladas, que reiniciam a análise a cada resposta incompleta',
  'Dificuldade em contratos, seguros e vistorias que pedem a documentação em dia',
  'Responsabilidade da administração ou do síndico sobre uma pendência conhecida',
  'Retrabalho: quanto mais antiga a irregularidade, mais cara a adequação',
] as const

const etapas = [
  {
    titulo: 'Diagnóstico da edificação',
    descricao:
      'O que existe, o que está vencido, o que nunca foi feito e qual é a situação junto ao órgão.',
  },
  {
    titulo: 'Plano de regularização',
    descricao:
      'Etapas, responsáveis e o que depende de profissional habilitado ou de empresa executora.',
  },
  {
    titulo: 'Execução coordenada',
    descricao:
      'Projetos, laudos e sistemas preventivos com profissionais e parceiros habilitados, sob nossa coordenação.',
  },
  {
    titulo: 'Protocolo e acompanhamento',
    descricao: 'Processo protocolado, exigências respondidas e vistorias acompanhadas.',
  },
  {
    titulo: 'Manutenção da regularidade',
    descricao: 'Controle de vencimentos para a renovação não pegar ninguém de surpresa.',
  },
] as const
---

<LayoutStudiova
  titulo="Segurança contra incêndio e pânico em João Pessoa (PB) | Bradotec Fire"
  descricao="Regularização de segurança contra incêndio e pânico em João Pessoa/PB: levantamento documental, AVCB e documentos equivalentes, vistorias, exigências, brigada, projetos e laudos com profissionais habilitados."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoSaida}
    descricaoDaFoto="Placa iluminada de saída de emergência sob a laje de uma garagem"
    titulo="Segurança contra incêndio e pânico"
    subtitulo="A regularização que trava alvará, obra e funcionamento, conduzida do levantamento inicial até a conclusão do processo, em João Pessoa e região."
    trilha={trilha}
  >
    <BotaoSeta href="/diagnostico">Responder as 4 perguntas</BotaoSeta>
  </CabecalhoPagina>

  <!-- 01 — Quando vira urgência -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="01"
          etiqueta="Bradotec Fire"
          titulo="Quando esse processo vira urgência"
          descricao="Condomínio com exigência aberta, comércio que não consegue renovar o alvará, edificação que nunca foi regularizada, instituição que recebe público e precisa se adequar. São situações diferentes com o mesmo efeito: a operação fica exposta."
        />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <a
              href="/avcb"
              class="link-hover hstack gap-2 fs-5 fw-bold text-primary w-fit"
              data-aos="fade-up"
              data-aos-delay="200"
              data-aos-duration="1000"
            >
              Entenda o AVCB: o que é, o que exige e o que muda quando vence
              <iconify-icon icon="lucide:arrow-up-right" class="fs-6 flex-shrink-0" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SecaoServicos
    divisao="fire"
    numero="02"
    etiqueta="Serviços"
    titulo="O que a divisão Fire conduz"
    descricao="Da organização do que já existe até o acompanhamento da vistoria, dentro de um único processo."
  />

  <!-- 03 — O que está em jogo -->
  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="03"
          etiqueta="O que está em jogo"
          titulo="Documentação de incêndio pendente não fica parada. Ela cobra."
          descricao="Enquanto o processo não é concluído, a edificação segue exposta em frentes que costumam aparecer todas juntas, e quase sempre no pior momento."
          escuro
        />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <ul class="list-unstyled mb-0">
              {
                riscos.map((risco, i) => (
                  <li
                    class="py-5 border-top border-white border-opacity-10 hstack gap-5 align-items-start"
                    data-aos="fade-up"
                    data-aos-delay={`${(i + 1) * 100}`}
                    data-aos-duration="1000"
                  >
                    <iconify-icon
                      icon="solar:danger-triangle-bold"
                      class="fs-7 text-primary flex-shrink-0"
                    />
                    <span class="fs-5 text-white text-opacity-75">{risco}</span>
                  </li>
                ))
              }
            </ul>

            <div class="hstack gap-3 flex-wrap mt-7">
              <BotaoSeta origem="incendio">Quero regularizar contra incêndio</BotaoSeta>
              <BotaoSeta href="/diagnostico" tom="contorno">Responder as 4 perguntas</BotaoSeta>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — Como conduzimos -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao numero="04" etiqueta="Processo" titulo="Como conduzimos o processo" />

        <div class="row">
          {
            etapas.map((etapa, i) => (
              <div class="col-md-6 col-lg-4 col-xl mb-7 mb-xl-0">
                <div
                  class="d-flex flex-column gap-4 pt-7 border-top h-100"
                  data-aos="fade-up"
                  data-aos-delay={`${(i + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <h2 class="mb-0 fs-12 text-primary">{String(i + 1).padStart(2, '0')}</h2>
                  <h3 class="mb-0 fs-6">{etapa.titulo}</h3>
                  <p class="mb-0 fs-4">{etapa.descricao}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/*
    05 — Por que despachante.
    O argumento e de lei, e nao de opiniao, e por isso a lei aparece citada.
    Ver src/config/despachante.ts: a redacao dos itens segue a do texto legal
    de perto, e quem reescrever para soar mais comercial precisa conferir.
  */}
  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray" id="por-que-despachante">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="05"
          etiqueta="Quem conduz o processo"
          titulo="Por que isso é trabalho de despachante documentalista"
          descricao="O processo junto ao Corpo de Bombeiros não é um documento, é uma tramitação: protocolo, análise, exigência, resposta à exigência, vistoria e emissão. Quem conduz precisa conhecer o rito, e não apenas a norma técnica."
        />

        <div class="row">
          <div class="col-lg-6 mb-7 mb-lg-0">
            <div
              class="card bg-primary h-100"
              data-aos="fade-up"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              <div class="card-body d-flex flex-column gap-4">
                <span class="badge bg-white text-primary w-fit fs-3">
                  A profissão é regulamentada
                </span>
                <p class="mb-0 fs-4">
                  A <a class="text-white fw-bold" href={leiDaProfissao.url} rel="noopener" target="_blank">{leiDaProfissao.rotulo}</a> define
                  as atribuições do despachante documentalista como os atos e procedimentos legais
                  necessários à mediação e à representação do cliente perante os órgãos da
                  administração pública. Na prática, é isto:
                </p>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                  {
                    atribuicoes.map((item) => (
                      <li class="hstack gap-3 align-items-start fs-4">
                        <iconify-icon icon="solar:check-circle-bold" class="fs-6 flex-shrink-0" />
                        <span>{item}</span>
                      </li>
                    ))
                  }
                </ul>
                <p class="mb-0 pt-4 border-top fs-3">
                  Para exercer, a lei exige {condicoesParaExercer[0]} e {condicoesParaExercer[1]}.
                </p>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div
              class="d-flex flex-column gap-4"
              data-aos="fade-up"
              data-aos-delay="200"
              data-aos-duration="1000"
            >
              <h3 class="mb-0 fs-7">O que costuma acontecer sem isso</h3>
              <dl class="mb-0 border-top">
                {
                  semDespachante.map((caso) => (
                    <div class="border-bottom py-4">
                      <dt class="fs-5 fw-bold text-dark">{caso.quem}</dt>
                      <dd class="mb-0 mt-1 fs-4">{caso.oQueAcontece}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="mb-0 fs-4">
                Nada disso substitui o engenheiro. Projeto e laudo continuam sendo de quem tem
                habilitação legal para assinar, e a aprovação continua sendo do Corpo de Bombeiros.
                O que muda é ter alguém cuja profissão é justamente conduzir o processo até lá.
              </p>
              <a
                class="link-hover hstack gap-2 fs-5 fw-bold text-primary w-fit"
                href="/sobre#quem-esta-por-tras"
              >
                Ver o registro e a formação de quem responde
                <iconify-icon icon="lucide:arrow-up-right" class="fs-6 flex-shrink-0" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AvisoEscopo titulo="O que a Bradotec faz e o que é feito por terceiros">
    A Bradotec atua na gestão documental, na condução administrativa e no acompanhamento do
    processo. Projetos, laudos, instalação e manutenção de sistemas preventivos exigem habilitação
    específica e são executados por profissionais e empresas legalmente habilitados, com quem a
    Bradotec coordena o trabalho. Prazos de análise, vistoria e aprovação dependem do órgão
    competente.
  </AvisoEscopo>

  <AcordeaoFaq pagina="seguranca-contra-incendio" numero="06" />
</LayoutStudiova>
