---
import { getCollection } from 'astro:content'
import fotoProcesso from '@/assets/fotos-geradas/processo-carimbado.jpg'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import { site } from '@/config/site'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Artigos técnicos', href: '/artigos' },
] as const

/** Mais recente primeiro. Norma nova envelhece rápido o que veio antes. */
const artigos = (await getCollection('artigos')).sort((a, b) =>
  b.data.data.localeCompare(a.data.data)
)

const emPortugues = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
---

<LayoutStudiova
  titulo={`Artigos técnicos sobre segurança contra incêndio e regularização | ${site.nome}`}
  descricao="Artigos da Bradotec sobre normas técnicas, segurança contra incêndio e regularização de edificações na Paraíba, escritos para síndicos, administradoras e responsáveis por operações."
  trilha={trilha}
>
  <CabecalhoPagina
    foto={fotoProcesso}
    descricaoDaFoto="Pasta com documentos assinados e carimbados sobre uma mesa escura, ao lado de um carimbo e de uma planta"
    enquadramento="50% 45%"
    titulo="Artigos técnicos"
    subtitulo="O que muda na norma, explicado para quem administra a edificação e precisa decidir o que fazer."
    trilha={trilha}
  />

  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xl-9">
          <h2 class="visually-hidden">Lista de artigos</h2>

          {
            artigos.length === 0 && (
              <p class="fs-5 mb-0">
                Nenhum artigo publicado ainda. O primeiro sai assim que houver norma nova que mude
                alguma coisa na prática.
              </p>
            )
          }

          {/*
            Lista, e nao grade de cartoes. Com um artigo so, uma grade de tres
            colunas mostraria um cartao solitario e dois vazios. A lista cresce
            sem mudar de forma.
          */}
          <ul class="list-unstyled mb-0 border-top">
            {
              artigos.map((artigo, i) => (
                <li class="border-bottom">
                  <a
                    class="artigo-item d-block py-7 text-decoration-none"
                    href={`/artigos/${artigo.data.slug}`}
                    data-aos="fade-up"
                    data-aos-delay={`${(i + 1) * 100}`}
                    data-aos-duration="1000"
                  >
                    <div class="hstack gap-3 flex-wrap mb-3">
                      <span class="badge bg-primary fs-3">{artigo.data.tema}</span>
                      <span class="fs-3 text-muted">
                        {emPortugues(artigo.data.data)} · {artigo.data.minutos} min de leitura
                      </span>
                    </div>
                    <h3 class="mb-3 fs-8 text-dark artigo-titulo">{artigo.data.titulo}</h3>
                    <p class="mb-3 fs-5 artigo-resumo">{artigo.data.resumo}</p>
                    <span class="hstack gap-2 fs-5 fw-bold text-primary">
                      Ler o artigo
                      <iconify-icon icon="lucide:arrow-up-right" class="fs-6" />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</LayoutStudiova>

<style>
  .artigo-titulo {
    max-width: 30ch;
    transition: color 0.15s;
  }

  .artigo-resumo {
    max-width: 66ch;
  }

  .artigo-item:hover .artigo-titulo {
    color: var(--brad-vinho) !important;
  }
</style>
