---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import fotoInstrutor from '@/assets/fotos/instrutor-demonstracao.jpg'
import fotoTurma from '@/assets/fotos/turma-treinamento.jpg'
import fotoTreinamento from '@/assets/fotos-licenciadas/treinamento-com-extintor.jpg'
import AcordeaoFaq from '@/components/studiova/AcordeaoFaq.astro'
import AvisoEscopo from '@/components/studiova/AvisoEscopo.astro'
import Botao from '@/components/studiova/Botao.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import Icone from '@/components/studiova/Icone.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import { site } from '@/config/site'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
  { nome: 'Treinamentos', href: '/treinamentos' },
] as const

const schemaFaq = await schemaFaqDaPagina('treinamentos')

const cursos = (await getCollection('treinamentos')).sort((a, b) => a.data.ordem - b.data.ordem)

/**
 * Quem aparece na foto. Vem da colecao, e nao escrito aqui, para o nome e a
 * formacao nao divergirem do que /sobre diz sobre a mesma pessoa.
 */
const [lider] = (await getCollection('lideranca')).sort((a, b) => a.data.ordem - b.data.ordem)

/** Quem costuma contratar. Sao os mesmos publicos ja atendidos pela empresa. */
const publicos = [
  'Condomínios residenciais e comerciais',
  'Empresas, indústrias e comércios',
  'Igrejas, escolas e instituições',
  'Clínicas, academias e consultórios',
  'Postos de combustível',
  'Administradoras e equipes de portaria',
] as const

const motivos = [
  {
    icone: 'solar:document-text-line-duotone',
    titulo: 'É item do AVCB',
    descricao:
      'O atestado de brigada de incêndio está entre os documentos exigidos na regularização junto ao Corpo de Bombeiros. Sem a equipe formada, o processo trava nesse ponto.',
    href: '/avcb',
    rotuloDoLink: 'Ver o que o AVCB exige',
  },
  {
    icone: 'solar:alarm-turn-off-line-duotone',
    titulo: 'A emergência não avisa',
    descricao:
      'Entre o acidente e a chegada do socorro existem alguns minutos em que só quem está no local pode agir. O que acontece nesses minutos costuma decidir o resto.',
  },
  {
    icone: 'solar:shield-user-line-duotone',
    titulo: 'Reduz a exposição de quem administra',
    descricao:
      'Síndico e responsável legal respondem pela administração. Equipe treinada e treinamento registrado mudam a posição de quem administra diante de uma ocorrência.',
  },
] as const
---

<LayoutStudiova
  titulo={`Curso de brigada de incêndio e primeiros socorros em ${site.cidade} (${site.estado}) | ${site.nome}`}
  descricao="Treinamento de brigada de incêndio e de primeiros socorros para condomínios, empresas, escolas e instituições em João Pessoa e região, conduzido dentro do processo de regularização."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    foto={fotoTreinamento}
    descricaoDaFoto="Participantes de um treinamento usando extintor sobre um foco de fogo controlado, ao ar livre"
    enquadramento="50% 52%"
    titulo="Treinamento de brigada de incêndio e primeiros socorros"
    subtitulo="Para a equipe saber o que fazer nos primeiros minutos, e para a edificação cumprir o que o Corpo de Bombeiros exige."
    trilha={trilha}
  >
    <Botao href="/contato">Solicitar proposta</Botao>
  </CabecalhoPagina>

  <!-- 01 — Por que treinar -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="01"
          etiqueta="Bradotec Fire"
          titulo="Por que treinar a equipe"
          descricao="O treinamento entra no mesmo processo do resto da regularização. Quem já cuida da documentação da edificação forma a brigada dela, sem contratar dois fornecedores para o mesmo assunto."
        />

        {/*
          Foto real, visivel e sem veu. `width`/`height` explicitos para o
          `src` de fallback nao apontar para o arquivo de 3024px.
        */}
        <figure
          class="m-0"
          data-aos="fade-up"
          data-aos-delay="200"
          data-aos-duration="1000"
        >
          <Image
            src={fotoInstrutor}
            alt={`${lider?.data.nome ?? 'Instrutor da Bradotec'} preparando a demonstração prática com botijão de gás, ao lado das placas de extintor de água e de pó BC`}
            width={1280}
            height={560}
            widths={[768, 1280]}
            sizes="(min-width: 1200px) 1140px, 100vw"
            loading="lazy"
            class="img-fluid w-100 rounded-4 foto-larga"
          />
          <figcaption class="mt-3 fs-3 text-muted">
            Montagem da demonstração prática, antes da queima controlada.
            {
              lider && (
                <>
                  {' '}Conduzida por{' '}
                  <a class="fw-bold text-primary" href="/sobre#quem-esta-por-tras">
                    {lider.data.nome}
                  </a>, técnico em prevenção e combate a incêndio.
                </>
              )
            }
          </figcaption>
        </figure>

        <div class="row">
          {
            motivos.map((motivo, i) => (
              <div class="col-lg-4 mb-7 mb-lg-0">
                <div
                  class="d-flex flex-column gap-4 pt-7 border-top h-100"
                  data-aos="fade-up"
                  data-aos-delay={`${(i + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <Icone nome={motivo.icone} class="fs-11 text-primary" />
                  <h3 class="mb-0 fs-6">{motivo.titulo}</h3>
                  <p class="mb-0 fs-4">{motivo.descricao}</p>
                  {
                    'href' in motivo && (
                      <a class="link-hover hstack gap-2 fs-4 fw-bold text-primary w-fit" href={motivo.href}>
                        {motivo.rotuloDoLink}
                        <Icone nome="lucide:arrow-up-right" class="fs-5" />
                      </a>
                    )
                  }
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — Os dois treinamentos -->
  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="02"
          etiqueta="Programa"
          titulo="Os dois treinamentos"
          descricao="Podem ser contratados juntos ou separados, e são adaptados ao tipo de edificação e ao perfil da equipe. O conteúdo abaixo é o programa de referência."
        />

        <div class="row">
          {
            cursos.map(({ data }, i) => (
              <div class="col-lg-6 mb-7 mb-lg-0">
                <article
                  class="card divisao divisao-fire border bg-white h-100"
                  data-aos="fade-up"
                  data-aos-delay={`${(i + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <div class="card-body d-flex flex-column gap-4">
                    <h3 class="mb-0 fs-7">{data.titulo}</h3>
                    <p class="mb-0 fs-5 text-primary fw-bold">{data.chamada}</p>
                    <p class="mb-0 fs-4">{data.resumo}</p>

                    <p class="mb-0 mt-2 fs-3 fw-bold text-uppercase text-muted">Programa</p>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                      {data.conteudo.map((topico) => (
                        <li class="hstack gap-3 align-items-start fs-4">
                          <Icone
                            nome="solar:check-circle-bold"
                            class="divisao-marca fs-6 flex-shrink-0"
                          />
                          <span>{topico}</span>
                        </li>
                      ))}
                    </ul>

                    <p class="mb-0 mt-2 pt-4 border-top fs-3 text-muted">
                      Conteúdo orientado por {data.normas}.
                    </p>
                  </div>
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — Para quem é -->
  <section class="py-5 py-lg-11 py-xl-12">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="03"
          etiqueta="Público"
          titulo="Para quem é"
          descricao="O treinamento é realizado na própria edificação, com a equipe que de fato estará lá no dia da ocorrência: porteiro, zelador, funcionário, morador voluntário."
        />

        <div class="row justify-content-end">
          <div class="col-xl-8">
            <div class="row">
              {
                publicos.map((publico, i) => (
                  <div class="col-sm-6 mb-4">
                    <div
                      class="hstack gap-3 align-items-start py-3 border-bottom"
                      data-aos="fade-up"
                      data-aos-delay={`${((i % 2) + 1) * 100}`}
                      data-aos-duration="800"
                    >
                      <Icone
                        nome="solar:check-circle-bold"
                        class="fs-6 text-primary flex-shrink-0"
                      />
                      <span class="fs-4 text-dark">{publico}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — Proposta -->
  <section class="py-5 py-lg-11 py-xl-12 bg-dark">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="04"
          etiqueta="Proposta"
          titulo="A proposta sai depois de olhar a sua edificação"
          descricao="Carga horária, tamanho da brigada e formato dependem da ocupação, da população fixa e do risco. Não existe pacote único que sirva para condomínio de doze apartamentos e para indústria. Por isso não publicamos tabela de preço: o número sairia errado para quase todo mundo."
          escuro
        />

        <div class="row justify-content-between gap-7 gap-xl-0 align-items-center">
          <div class="col-xl-5">
            <div
              class="d-flex flex-column gap-4"
              data-aos="fade-right"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              <p class="mb-0 fs-5 text-white text-opacity-75">
                Diga quantas pessoas participariam e que tipo de edificação é, e a proposta volta
                com o dimensionamento já feito.
              </p>
              <div>
                <Botao origem="treinamento">Solicitar proposta</Botao>
              </div>
            </div>
          </div>

          <div class="col-xl-6">
            {/*
              Foto real de um treinamento conduzido pela Bradotec. Fica
              visivel, sem veu: e a coisa mais forte que o site tem para
              mostrar. `width`/`height` explicitos porque o original tem
              3120px e o `src` de fallback baixava 1 MB.
            */}
            <figure
              class="m-0"
              data-aos="fade-left"
              data-aos-delay="200"
              data-aos-duration="1000"
            >
              <Image
                src={fotoTurma}
                alt="Turma ao final de um treinamento da Bradotec, reunida atrás de uma queima controlada, com extintores de CO2 e de pó BC em primeiro plano"
                width={960}
                height={1280}
                widths={[640, 960]}
                sizes="(min-width: 1200px) 40vw, 100vw"
                loading="lazy"
                class="img-fluid w-100 rounded-4"
              />
              <figcaption class="mt-3 fs-3 text-white text-opacity-50">
                Fim de um treinamento com queima controlada, em João Pessoa.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AvisoEscopo titulo="O que a Bradotec faz e o que é feito por terceiros">
    A Bradotec organiza e conduz o treinamento dentro do processo de regularização, com instrutores
    e empresas legalmente habilitados para a formação de brigada. Projetos, laudos e a instalação
    de sistemas preventivos seguem sendo executados por profissionais com a habilitação exigida
    para cada caso. A aprovação da documentação junto ao Corpo de Bombeiros depende do órgão
    competente.
  </AvisoEscopo>

  <AcordeaoFaq
    pagina="treinamentos"
    numero="05"
    titulo="Perguntas frequentes sobre os treinamentos"
  />
</LayoutStudiova>

<style>
  .foto-larga {
    aspect-ratio: 16 / 7;
    object-fit: cover;
    object-position: 50% 42%;
  }
</style>
