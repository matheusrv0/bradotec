---
import { Image } from 'astro:assets'
import logo from '@/assets/marca/logo-bradotec.png'
import { enderecoCompleto, site } from '@/config/site'
import { linkWhatsapp } from '@/config/whatsapp'

/**
 * A pagina do link da bio do Instagram.
 *
 * E a unica pagina do site sem cabecalho, rodape nem menu, e isso e
 * deliberado: quem chega aqui vem de um aplicativo, num celular, com uma
 * duvida so. Menu de nove itens nessa hora e caminho para desistir. Sao
 * quatro botoes, um deles em destaque, e nada mais.
 *
 * O desenho veio pronto do cliente, em HTML avulso. O que mudou na
 * transposicao foi de onde vem o conteudo: telefone, e-mail, endereco, CNPJ
 * e CRDD saem de src/config/site.ts e da colecao de lideranca, como no resto
 * do site. No arquivo avulso os quatro estavam escritos a mao, e os quatro
 * divergiam do que o site publica. Dado escrito duas vezes envelhece em uma
 * das duas.
 *
 * Fica fora da busca (`noindex`): e porta de entrada de campanha, nao pagina
 * de conteudo, e indexada competiria com a home pelo nome da empresa.
 */

const whatsappInstagram = linkWhatsapp('instagram')
const whatsappVistoria = linkWhatsapp('vistoria')

const siteUrl = Astro.site?.href ?? 'https://bradotec.com.br/'

/** Sem numero cadastrado, o botao leva ao formulario em vez de quebrar. */
const ondeFalar = whatsappInstagram ?? '/contato'
const ondeAgendar = whatsappVistoria ?? '/contato'

const botoes = [
  {
    href: ondeFalar,
    externo: Boolean(whatsappInstagram),
    destaque: true,
    icone: 'whatsapp',
    titulo: 'Falar no WhatsApp',
    apoio: site.horario,
  },
  {
    href: ondeAgendar,
    externo: Boolean(whatsappVistoria),
    destaque: false,
    icone: 'prancheta',
    titulo: 'Agendar vistoria técnica',
    apoio: 'Levantamento do que está vencido na edificação',
  },
  {
    href: '/',
    externo: false,
    destaque: false,
    icone: 'globo',
    titulo: 'Nosso site',
    apoio: 'Serviços, artigos técnicos e o plano anual',
  },
  {
    href: `mailto:${site.email}`,
    externo: false,
    destaque: false,
    icone: 'envelope',
    titulo: 'E-mail',
    apoio: site.email,
  },
] as const
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.nome}: links</title>
    <meta
      name="description"
      content={`${site.nome}: regularização e gestão documental em segurança contra incêndio e pânico em ${site.cidade} e região.`}
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL('/links', siteUrl).href} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={`${site.nome}: links`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/links', siteUrl).href} />
    <meta property="og:image" content={new URL('/og-bradotec.jpg', siteUrl).href} />
  </head>

  <body>
    <main class="folha">
      <Image src={logo} alt={site.nome} width={420} class="marca" loading="eager" />

      <p class="etiqueta">Regularização e gestão documental</p>
      <p class="resumo">
        Segurança contra incêndio e pânico para condomínios, empresas e instituições em {
          site.cidade
        } e região.
      </p>

      <nav aria-label="Canais de contato">
        {
          botoes.map((botao) => (
            <a
              class:list={['botao', botao.destaque && 'destaque']}
              href={botao.href}
              {...botao.externo ? { target: '_blank', rel: 'noopener' } : {}}
            >
              <span class="icone" aria-hidden="true">
                {botao.icone === 'whatsapp' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.3.5-.3.3c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 1.9 1.1.9 1.9 1.2 2.2 1.4.3.1.5.1.6-.1l.8-1c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.6-.1 1.1Z" />
                  </svg>
                )}
                {botao.icone === 'prancheta' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M17 3h-2.2a3 3 0 0 0-5.6 0H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Zm-5 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm4.3 7.7-5 5a1 1 0 0 1-1.4 0l-2.2-2.2 1.4-1.4 1.5 1.5 4.3-4.3 1.4 1.4Z" />
                  </svg>
                )}
                {botao.icone === 'globo' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 9h-3a15 15 0 0 0-1.2-5.3A8 8 0 0 1 18.9 11ZM12 4.2c.7 1 1.5 3 1.7 6.8h-3.4C10.5 7.2 11.3 5.2 12 4.2ZM5.1 11a8 8 0 0 1 4.2-5.3A15 15 0 0 0 8.1 11h-3Zm0 2h3a15 15 0 0 0 1.2 5.3A8 8 0 0 1 5.1 13Zm6.9 6.8c-.7-1-1.5-3-1.7-6.8h3.4c-.2 3.8-1 5.8-1.7 6.8Zm2.7-1.5a15 15 0 0 0 1.2-5.3h3a8 8 0 0 1-4.2 5.3Z" />
                  </svg>
                )}
                {botao.icone === 'envelope' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 8 8-5H4l8 5Zm0 2.3L4 10v7h16v-7l-8 5.3Z" />
                  </svg>
                )}
              </span>
              <span class="texto">
                {botao.titulo}
                <small>{botao.apoio}</small>
              </span>
            </a>
          ))
        }
      </nav>

      <p class="rodape">
        <strong>{site.nome}</strong><br />
        {enderecoCompleto}<br />
        CNPJ {site.cnpj}
      </p>
    </main>

    <style>
      /*
       * Estilo proprio, sem o Bootstrap do resto do site. A pagina nao carrega
       * folha nenhuma de fora: quem abre isto esta no navegador embutido do
       * Instagram, muitas vezes no 4G, e cada pedido a mais e meio segundo a
       * mais de tela branca.
       */
      :root {
        --vinho: #8e1c21;
        --vinho-escuro: #741418;
        --grafite: #201c1e;
        --papel: #f4f0f0;
        --cinza: #6d6669;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        justify-content: center;
        background: var(--vinho);
        background-image: radial-gradient(
          120% 70% at 50% -10%,
          #a52329 0%,
          var(--vinho) 45%,
          var(--vinho-escuro) 100%
        );
        color: #fff;
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .folha {
        width: 100%;
        max-width: 460px;
        padding: calc(40px + env(safe-area-inset-top, 0px)) 22px
          calc(48px + env(safe-area-inset-bottom, 0px));
        text-align: center;
      }

      .marca {
        width: 200px;
        max-width: 60%;
        height: auto;
        margin: 0 auto 16px;
        display: block;
      }

      .etiqueta {
        margin: 0 0 20px;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #eccfd0;
      }

      .resumo {
        margin: 0 auto 28px;
        max-width: 34ch;
        font-size: 0.95rem;
        line-height: 1.55;
        color: #f7e7e7;
      }

      nav {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      /*
       * 56px de altura minima nao e numero redondo por acaso: e o alvo de
       * toque confortavel no celular. O site inteiro ja segue 44px como piso,
       * e aqui, onde cada botao e uma decisao, vale mais folga.
       */
      .botao {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 56px;
        padding: 14px 18px;
        border-radius: 14px;
        background: #fff;
        color: var(--grafite);
        text-align: left;
        text-decoration: none;
        font-size: 0.97rem;
        font-weight: 700;
        box-shadow: 0 2px 10px rgb(0 0 0 / 0.16);
        transition: background-color 150ms ease;
      }

      .botao:active {
        translate: 0 1px;
      }

      .botao .icone {
        flex: 0 0 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--papel);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .botao .icone svg {
        width: 19px;
        height: 19px;
        fill: var(--vinho);
      }

      .botao .texto {
        flex: 1;
        min-width: 0;
      }

      .botao .texto small {
        display: block;
        margin-top: 2px;
        font-weight: 400;
        font-size: 0.78rem;
        color: var(--cinza);
      }

      /*
       * O verde e o mesmo do botao flutuante do site (`--color-whats-dark`),
       * e nao o do arquivo original. Aquele era #0f8a3d, e branco sobre ele da
       * 4.45:1, logo abaixo do minimo de 4.5:1 da WCAG AA. A varredura cega de
       * contraste pegou; a olho nu passaria, porque a diferenca e de meio
       * ponto. Este da 5.80:1 e ainda casa com o resto do site.
       */
      .botao.destaque {
        background: #0e7539;
        color: #fff;
      }

      .botao.destaque .icone {
        background: rgb(255 255 255 / 0.18);
      }

      .botao.destaque .icone svg {
        fill: #fff;
      }

      /* Branco a 88% sobre o verde da 4.94:1, ainda acima do minimo. */
      .botao.destaque .texto small {
        color: rgb(255 255 255 / 0.88);
      }

      .rodape {
        margin: 30px 0 0;
        font-size: 0.74rem;
        line-height: 1.75;
        color: #e6cccd;
      }

      .rodape strong {
        color: #fff;
      }

      /* Mesmo anel de foco do resto do site: branco por dentro, grafite por
         fora, para enxergar sobre o vinho e sobre o branco do botao. */
      a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 0;
        box-shadow: 0 0 0 5px var(--grafite);
      }

      @media (prefers-reduced-motion: reduce) {
        .botao {
          transition-duration: 1ms;
        }
      }
    </style>
  </body>
</html>
