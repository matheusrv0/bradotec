---
import fotoAtendimento from '@/assets/fotos-licenciadas/escritorio-atendimento.jpg'
import Botao from '@/components/studiova/Botao.astro'
import CabecalhoPagina from '@/components/studiova/CabecalhoPagina.astro'
import DadoPendente from '@/components/studiova/DadoPendente.astro'
import FormularioContato from '@/components/studiova/FormularioContato.astro'
import Icone from '@/components/studiova/Icone.astro'
import TituloSecao from '@/components/studiova/TituloSecao.astro'
import { enderecoCompleto, instagramUsuario, site } from '@/config/site'
import LayoutStudiova from '@/layouts/LayoutStudiova.astro'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Contato', href: '/contato' },
] as const

const canais = [
  { icone: 'lucide:phone', rotulo: 'Telefone', valor: site.telefone },
  { icone: 'lucide:mail', rotulo: 'E-mail', valor: site.email },
  { icone: 'lucide:map-pin', rotulo: 'Endereço', valor: enderecoCompleto },
  { icone: 'lucide:clock', rotulo: 'Atendimento', valor: site.horario },
  { icone: 'lucide:instagram', rotulo: 'Instagram', valor: instagramUsuario },
  { icone: 'lucide:map', rotulo: 'Região', valor: site.regiaoAtendida },
] as const
---

<LayoutStudiova
  titulo={`Contato: falar com a ${site.nome} em ${site.cidade} (${site.estado})`}
  descricao="Fale com a Bradotec em João Pessoa/PB por WhatsApp, telefone ou e-mail. Conte a sua situação de regularização, licença, segurança contra incêndio ou documentação veicular."
  trilha={trilha}
>
  <CabecalhoPagina
    foto={fotoAtendimento}
    descricaoDaFoto="Escritório com estações de trabalho e janelas amplas ao fundo"
    enquadramento="50% 46%"
    titulo="Falar com a Bradotec"
    subtitulo="Conte a sua situação pelo canal que preferir. O retorno é feito por quem vai conduzir o processo."
    trilha={trilha}
  >
    <Botao href="#formulario" tom="contorno">Ir para o formulário</Botao>
  </CabecalhoPagina>

  <section class="py-5 py-lg-11 py-xl-12" id="formulario">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao
          numero="01"
          etiqueta="Formulário"
          titulo="Solicitar orçamento ou diagnóstico"
          descricao="Quanto mais específico for o que você contar, mais direto será o retorno."
        />

        <div class="row justify-content-between gap-7 gap-xl-0">
          <div class="col-xl-4">
            <div
              class="card bg-primary"
              data-aos="fade-right"
              data-aos-delay="100"
              data-aos-duration="1000"
            >
              <div class="card-body d-flex flex-column gap-4">
                <Icone nome="lucide:message-circle" class="fs-11" />
                <h3 class="mb-0 fs-7">WhatsApp comercial</h3>
                <p class="mb-0 fs-4">Canal mais rápido para orçamento, diagnóstico e dúvidas.</p>
                <div>
                  <Botao origem="padrao" tom="branco">Abrir conversa</Botao>
                </div>
              </div>
            </div>
          </div>

          <div class="col-xl-7">
            <div
              class="card border bg-white"
              data-aos="fade-up"
              data-aos-delay="200"
              data-aos-duration="1000"
            >
              <div class="card-body">
                <FormularioContato />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 py-lg-11 py-xl-12 bg-light-gray">
    <div class="container">
      <div class="d-flex flex-column gap-5 gap-xl-10">
        <TituloSecao numero="02" etiqueta="Canais" titulo="Onde encontrar a Bradotec" />

        <div class="row">
          {
            canais.map((canal, i) => (
              <div class="col-md-6 col-lg-4 mb-6">
                <div
                  class="card border h-100 bg-white"
                  data-aos="fade-up"
                  data-aos-delay={`${((i % 3) + 1) * 100}`}
                  data-aos-duration="1000"
                >
                  <div class="card-body d-flex flex-column gap-3 p-6">
                    <Icone nome={canal.icone} class="fs-9 text-primary" />
                    <p class="mb-0 fs-3 fw-bold text-uppercase text-muted">{canal.rotulo}</p>
                    <p class="mb-0 fs-5 text-dark">
                      <DadoPendente valor={canal.valor} />
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</LayoutStudiova>
